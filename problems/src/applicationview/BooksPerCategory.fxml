<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.BooksPerCategoryController"
      spacing="10" alignment="CENTER" prefWidth="600" prefHeight="400">

    <TableView fx:id="categoryTable" prefHeight="300">
        <columns>
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="200"/>
            <TableColumn fx:id="countColumn" text="Count" prefWidth="100"/>
        </columns>
    </TableView>

</VBox>
