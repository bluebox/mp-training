<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400" prefWidth="600" spacing="10" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ActiveIssuedMembersController">
   <Label text="Active Issued Members">
      <font>
         <Font name="Bookman Old Style Bold" size="13.0" />
      </font>
   </Label>
   

    <TableView fx:id="membersTable" prefHeight="300">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="80" text="Member ID" />
            <TableColumn fx:id="nameColumn" prefWidth="100" text="Name" />
            <TableColumn fx:id="emailColumn" prefWidth="150" text="Email" />
            <TableColumn fx:id="mobileColumn" prefWidth="100" text="Mobile" />
            <TableColumn fx:id="addressColumn" prefWidth="150" text="Address" />
        </columns>
    </TableView>
   <Button mnemonicParsing="false" onAction="#gotoHome" text="Home" />
</VBox>
