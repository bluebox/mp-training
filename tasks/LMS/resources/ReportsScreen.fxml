<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="library.ui.ReportsScreen">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Library Reports">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button onAction="#handleOverdueBooksReport" text="Overdue Books" />
            <Button onAction="#handleBooksByCategoryReport" text="Books Per Category" />
            <Button onAction="#handleMembersWithActiveBooksReport" text="Members with Active Books" />
         </children>
      </HBox>
      <TextArea fx:id="reportDisplayArea" editable="false" prefHeight="400.0" prefWidth="600.0" wrapText="true" VBox.vgrow="ALWAYS" />
      <Label fx:id="messageLabel" textFill="#e11010">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button onAction="#handleBackToMainMenu" text="Back to Main Menu" />
         </children>
      </HBox>
   </children>
</VBox>