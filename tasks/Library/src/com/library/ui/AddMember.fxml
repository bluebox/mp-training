<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.*?>

<GridPane xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.library.controller.AddMemberController"
          hgap="10" vgap="10" alignment="CENTER">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <Label text="Email" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Mobile" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="mobileField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Label text="Gender" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <ChoiceBox fx:id="genderChoice" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <Label text="Address" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <TextField fx:id="addressField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

    <Button text="Add Member" onAction="#handleAddMember" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
     <Label fx:id="statusLabel" layoutX="30" layoutY="180" prefWidth="340" style="-fx-text-fill: green;"/>
</GridPane>
