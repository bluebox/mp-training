    @PostMapping("/login")
    public Map<String, Object> login(@RequestBody Map<String, String> loginData) throws Exception {
        String username = loginData.get("username");
        String password = loginData.get("password");

        if (username == null || username.trim().isEmpty()) {
            throw new RuntimeException("Username is required");
        }

        // get user (only password and id expected from repository)
        User user = mainUserService.getPassword(username);
        if (user == null) {
            throw new RuntimeException("There is no valid user with the given username");
        }

        // get role AFTER confirming user exists
        String role = "";
        try {
            role = roleService.getRoleName(user.getUserId());
        } catch (Exception ex) {
            // If user has no role assigned, decide desired behavior:
            // either set role = "UNKNOWN" or rethrow. Here we set empty role.
            role = "";
        }

        // NOTE: compare passwords securely (see note below). This example compares plaintext:
        if (!user.getPassword().equals(password)) {
            throw new RuntimeException("Invalid password");
        }

        Map<String, Object> response = new HashMap<>();
        response.put("jwt", username); // replace with actual JWT once implemented
        response.put("role", role == null || role.isEmpty() ? "ROLE_USER" : "ROLE_" + role);
        return response;
    }

    
    


