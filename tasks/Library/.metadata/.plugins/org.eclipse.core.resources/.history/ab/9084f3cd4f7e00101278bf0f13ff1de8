.navbar-container {
	display: flex;
    padding: 16px 24px;
    background-color: #333;
    color: #fff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
}

.navbar-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 28px;
}

.navbar-button {
    font-size: 16px;
    padding: 10px 16px;
    color: #fff;
    background: none;
    border: 1px solid #555;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

.navbar-button:hover {
    background-color: #555;
    border-color: #888;
}

.navbar-button:focus {
    outline: none;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.5);
}

.navbar-button:active {
    background-color: #444;
}