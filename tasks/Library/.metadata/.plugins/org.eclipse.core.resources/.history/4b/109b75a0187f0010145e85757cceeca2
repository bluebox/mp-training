/* ---------- Left vertical nav layout (scoped) ---------- */
/* Uses your existing classes: .navbar-container, .navbar-list, .navbar-button.
   Adds minimal new classes: .ui-leftnav-wrapper, .ui-top-right-profile, etc. */

.ui-leftnav-wrapper {
  position: relative; /* container for profile absolute positioning */
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
}

/* Convert existing navbar to a vertical sidebar */
.navbar-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 220px;                 /* sidebar width — tweak if needed */
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 20px 12px;
  background: #1f2937;          /* dark slate */
  color: #fff;
  border-right: 1px solid rgba(255,255,255,0.04);
  z-index: 1000;
  box-shadow: 0 6px 18px rgba(2,6,23,0.45);
}

/* Make the list vertical and full width */
.navbar-list {
  list-style: none;
  margin: 0;
  padding: 8px 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
}

/* Buttons fill width and align left */
.navbar-button {
  width: 100%;
  text-align: left;
  padding: 10px 14px;
  background: transparent;
  border: 1px solid rgba(255,255,255,0.06);
  color: #fff;
  border-radius: 8px;
  cursor: pointer;
  font-size: 15px;
  transition: background-color .18s ease, transform .06s ease;
}

/* Hover/focus/active visuals */
.navbar-button:hover,
.navbar-button:focus {
  background: rgba(255,255,255,0.04);
  outline: none;
  transform: translateY(-1px);
}
.navbar-button:active { transform: translateY(0); }

/* Ensure navbar doesn't affect other layouts: content should start to the right */
.appnav-content, /* if you used earlier pattern */
.main-content,  /* or other wrapper classes in app */
.content-root {  /* fallback name */
  margin-left: 220px;    /* same as sidebar width */
  padding-top: 64px;     /* if you have a top header height, else remove */
  box-sizing: border-box;
}

/* ---------- Top-right profile block (pure CSS, presentational) ---------- */
/* This styles optional markup; if you haven't added profile markup yet, use the tiny snippet below. */

.ui-top-right-profile {
  position: fixed;
  top: 12px;
  right: 18px;
  z-index: 1200;
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: Arial, sans-serif;
}

/* username text */
.ui-profile-username {
  display: inline-block;
  font-size: 14px;
  color: #111827;
  background: rgba(255,255,255,0.98);
  padding: 6px 10px;
  border-radius: 999px;
  box-shadow: 0 2px 6px rgba(2,6,23,0.08);
  max-width: 180px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* avatar button visual (non-functional) */
.ui-profile-avatar {
  width: 38px;
  height: 38px;
  border-radius: 999px;
  background: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: #111827;
  border: 1px solid rgba(17,24,39,0.06);
  cursor: pointer;
}

/* dropdown panel (presentational) */
.ui-profile-dropdown {
  position: absolute;
  top: 52px;
  right: 0;
  min-width: 140px;
  background: #ffffff;
  border-radius: 10px;
  border: 1px solid rgba(17,24,39,0.06);
  box-shadow: 0 10px 30px rgba(2,6,23,0.12);
  padding: 6px;
  display: none; /* remains hidden until JS toggles it */
}

/* dropdown item */
.ui-profile-dropdown button {
  display: block;
  width: 100%;
  text-align: left;
  padding: 8px 12px;
  background: transparent;
  border: none;
  cursor: pointer;
  font-weight: 600;
  color: #111827;
  border-radius: 6px;
}
.ui-profile-dropdown button:hover { background: #f3f4f6; }

/* If you want a CSS-only toggle (no JS) you can toggle the dropdown using the
   sibling or :focus-within approach; below is a helper you can enable if you
   place the dropdown inside a wrapper with class `.ui-profile-focus` */

/* Example (only if wrapper has class .ui-profile-focus): */
.ui-profile-focus:focus-within .ui-profile-dropdown,
.ui-profile-focus:hover .ui-profile-dropdown {
  display: block;
}

/* ---------- Responsive tweaks ---------- */
@media (max-width: 880px) {
  .navbar-container { width: 190px; }
  .appnav-content, .main-content, .content-root { margin-left: 190px; }
  .ui-profile-username { display: none; } /* hide name on small screens */
}

@media (max-width: 520px) {
  .navbar-container { position: static; width: 100%; height: auto; flex-direction: row; gap: 8px; padding: 8px; border-right: none; border-bottom: 1px solid rgba(0,0,0,0.06); }
  .navbar-list { flex-direction: row; gap: 8px; overflow-x: auto; }
  .appnav-content, .main-content, .content-root { margin-left: 0; padding-top: 84px; }
}
