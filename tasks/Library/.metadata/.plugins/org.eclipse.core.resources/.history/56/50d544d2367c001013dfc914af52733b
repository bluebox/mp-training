.update-member-container {
    padding: 20px;
    background-color: #f4f4f4;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
}

.update-member-form-container {
    background-color: #fff;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    width: 100%;
    max-width: 500px;
}

.update-member-form-container h2 {
    font-size: 1.5rem;
    font-weight: bold;
    margin-bottom: 20px;
}

.update-member-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.update-member-form-group {
	 display: flex;
  	/* flex-direction: column; */
    gap: 10px;
    align-items: center;
    text-align: right;
}

.update-member-form-group label {
    padding-right: 10px;
    font-weight: bold;
}

.update-member-form-group input {
    width: 100%;
    padding: 8px;
    border: 1px solid #ccc;
    border-radius: 4px;
    box-sizing: border-box;
}

.update-member-form-group .gender-options {
    display: flex;
    gap: 15px;
    justify-content: flex-start;
}

.update-member-button-group {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
}

.update-member-submit-btn, .update-member-back-btn {
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    color: white;
}

.update-member-submit-btn {
    background-color: #007bff;
}

.update-member-submit-btn:hover {
    background-color: #0056b3;
}

.update-member-back-btn {
    background-color: #6c757d;
}

.update-member-back-btn:hover {
    background-color: #5a6268;
}

.update-member-message {
    margin-top: 15px;
    text-align: center;
    font-size: 14px;
    font-weight: bold;
}
