import React from 'react';
import './Navbar.css';

const Navbar = ({ onNavigate }) => {
  const token = localStorage.getItem("jwtToken");

  if (!token) {
    return null;
  }

  return (
    <nav className="navbar-container">
      <ul className="navbar-list">
        <li>
          <button onClick={() => onNavigate('addUser')} className="navbar-button">
            Add User
          </button>
        </li>
        <li>
          <button onClick={() => onNavigate('viewUserRequests')} className="navbar-button">
            View User Requests
          </button>
        </li>
        <li>
          <button onClick={() => onNavigate('MainUsers')} className="navbar-button">
            View Main Users
          </button>
        </li>
      </ul>
    </nav>
  );
};

export default Navbar;
