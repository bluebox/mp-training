package com.users.Users.service;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.users.Users.model.Role;
import com.users.Users.model.UserRole;
import com.users.Users.repository.RoleRepository;

@Service
public class RoleService {
	
	private RoleRepository roleRepository;
	
	@Autowired
	public RoleService(RoleRepository roleRepository) {
		this.roleRepository=roleRepository;
	}
	
	public  List<Role> getRoles() {
		return  roleRepository.getUsers();
	}

	public void addUserRole(UserRole userRole) {
		roleRepository.addUserRole(userRole);
		
	}
	

}
