import React from 'react';

const Navbar = ({ onNavigate }) => {
  return (
    <nav style={{ backgroundColor: '#333', padding: '12px', color: '#fff' }}>
      <button
        onClick={() => onNavigate('add')}
        style={styles.button}
        type="button"
      >
        Add Book
      </button>

      <button
        onClick={() => onNavigate('view')}
        style={styles.button}
        type="button"
      >
        View Books
      </button>
    </nav>
  );
};

const styles = {
  button: {
    marginRight: '10px',
    padding: '8px 14px',
    fontSize: '14px',
    backgroundColor: '#555',
    color: '#fff',
    border: 'none',
    borderRadius: '4px',
    cursor: 'pointer'
  }
};

export default Navbar;
