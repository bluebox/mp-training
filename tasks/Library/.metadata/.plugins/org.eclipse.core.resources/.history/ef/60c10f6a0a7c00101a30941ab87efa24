import React, { useState, useEffect } from 'react';
import './UpdateBook.css';

const UpdateBook = ({ bookId, onNavigate }) => { // onNavigate is passed as a prop
  const [bookData, setBookData] = useState(null);
  const [categories, setCategories] = useState([]);
  const [statuses, setStatuses] = useState([]);
  const [availabilities, setAvailabilities] = useState([]);
  const [isLoading, setIsLoading] = useState(true);
  const [message, setMessage] = useState('');
  const [messageType, setMessageType] = useState('success');

  useEffect(() => {
    const fetchBookAndEnums = async () => {
      setIsLoading(true);
      try {
        const [catRes, statusRes, availRes, bookRes] = await Promise.all([
          fetch('/books/bookcategories'),
          fetch('/books/bookstatuses'),
          fetch('/books/bookavailabilities'),
          fetch(`/books/getbook/${bookId}`)
        ]);
        const [catData, statusData, availData, bookToEdit] = await Promise.all([
          catRes.json(),
          statusRes.json(),
          availRes.json(),
          bookRes.json()
        ]);

        setCategories(catData || []);
        setStatuses(statusData || []);
        setAvailabilities(availData || []);

        if (bookToEdit) {
          setBookData({
            bookId: bookToEdit.bookId,
            title: bookToEdit.title,
            author: bookToEdit.author,
            category: typeof bookToEdit.category === 'object' ? bookToEdit.category.code : bookToEdit.category,
            status: typeof bookToEdit.status === 'object' ? bookToEdit.status.code : bookToEdit.status,
            availability: typeof bookToEdit.availability === 'object' ? bookToEdit.availability.code : bookToEdit.availability,
          });
        } else {
          setMessage('Error: Book not found.');
          setMessageType('error');
        }

      } catch (err) {
        setMessage('Error fetching data.');
        setMessageType('error');
        console.error(err);
      } finally {
        setIsLoading(false);
      }
    };

    if (bookId) {
      fetchBookAndEnums();
    }
  }, [bookId]);

  const handleChange = (e) => {
    const { name, value } = e.target;
    setBookData(prev => ({ ...prev, [name]: value }));
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setMessage('Updating book...');
    setMessageType('success');

    try {
      const url = `/books/update/${bookId}`;
      const payload = {
        bookId: bookData.bookId,
        title: bookData.title,
        author: bookData.author,
        category: bookData.category,
        status: bookData.status,
        availability: bookData.availability
      };

      const res = await fetch(url, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (res.ok) {
        setMessage('Book updated successfully!');
        setMessageType('success');
        onNavigate('viewBooks'); 
      } else {
        const txt = await res.text();
        setMessage(`Server error: ${res.status} ${txt}`);
        setMessageType('error');
      }
    } catch (err) {
      console.error('Update error', err);
      setMessage('Error to Update book');
      setMessageType('error');
    }
  };

  if (isLoading || !bookData) return <div className="loading-message">{message || 'Loading book for update...'}</div>;

  return (
    <div className="update-book-container">
      <div className="update-book-form-container">
        <h2>Update Book</h2>
        <form onSubmit={handleSubmit} className="update-book-form">
          <div className="update-book-form-group">
            <label htmlFor="title">Title</label>
            <input name="title" id="title" value={bookData.title} onChange={handleChange} required />
          </div>
          <div className="update-book-form-group">
            <label htmlFor="author">Author</label>
            <input name="author" id="author" value={bookData.author} onChange={handleChange} required />
          </div>
          <div className="update-book-form-group">
            <label htmlFor="category">Category</label>
            <select name="category" id="category" value={bookData.category} onChange={handleChange} required>
              {categories.map(cat => (
                <option key={cat.code} value={cat.code}>{cat.displayName}</option>
              ))}
            </select>
          </div>
          <div className="update-book-form-group">
            <label htmlFor="status">Status</label>
            <select name="status" id="status" value={bookData.status} onChange={handleChange} required>
              {statuses.map(s => (
                <option key={s.code} value={s.code}>{s.displayName}</option>
              ))}
            </select>
          </div>
          <div className="update-book-form-group">
            <label htmlFor="availability">Availability</label>
            <select name="availability" id="availability" value={bookData.availability} onChange={handleChange} required>
              {availabilities.map(a => (
                <option key={a.code} value={a.code}>{a.displayName}</option>
              ))}
            </select>
          </div>
          <div className="update-book-button-group">
            <button type="submit" className="update-book-submit-btn">Update Book</button>
            <button type="button" onClick={() => onNavigate('viewBooks')} className="update-book-back-btn">Back</button>
          </div>
        </form>
        {message && <p className={`update-book-message ${messageType}`}>{message}</p>}
      </div>
    </div>
  );
};

export default UpdateBook;