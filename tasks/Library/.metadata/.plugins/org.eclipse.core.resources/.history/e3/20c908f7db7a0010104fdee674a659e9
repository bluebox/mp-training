/* Container for the entire page */
.container {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  padding: 30px;
  background-color: #e9ebee;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* Container for the form itself, with a soft shadow and rounded corners */
.form-container {
  background-color: #ffffff;
  padding: 40px;
  border-radius: 12px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  width: 100%;
  max-width: 450px;
  transition: transform 0.3s ease-in-out;
}

.form-container:hover {
  transform: translateY(-5px);
}

/* Heading style */
h2 {
  font-size: 2rem;
  font-weight: 600;
  margin-bottom: 30px;
  text-align: center;
  color: #333;
}

/* Form layout with spacing between elements */
.form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Individual form group for label and input */
.form-group {
  display: flex;
  flex-direction: column;
}

/* Label style */
.form-group label {
  margin-bottom: 8px;
  font-weight: 600;
  color: #555;
  font-size: 0.9rem;
}

/* Input and select box style */
.form-group input,
.form-group select {
  width: 100%;
  padding: 12px;
  border: 1px solid #ddd;
  border-radius: 8px;
  font-size: 1rem;
  transition: border-color 0.3s ease;
}

.form-group input:focus,
.form-group select:focus {
  outline: none;
  border-color: #007bff;
  box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.25);
}

/* Submit button style */
.submit-btn {
  width: 100%;
  padding: 15px;
  background-color: #007bff;
  color: #fff;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  font-size: 1.1rem;
  transition: background-color 0.3s ease, transform 0.1s ease;
  box-shadow: 0 4px 6px rgba(0, 123, 255, 0.2);
}

.submit-btn:hover {
  background-color: #0056b3;
  transform: translateY(-2px);
}

.submit-btn:active {
  transform: translateY(0);
  box-shadow: none;
}

/* Message style */
.message {
  margin-top: 20px;
  text-align: center;
  font-size: 1rem;
  font-weight: 500;
}
