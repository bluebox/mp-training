import React, { useState, useEffect } from 'react';
import './AddMember.css'; 

const AddMember = () => {
    const [genders, setGenders] = useState([]);
    const [memberData, setMemberData] = useState({
        name: '',
        email: '',
        phoneNumber: '',
        gender: '',
        address: ''
    });
    const [message, setMessage] = useState('');
	const [nameError, setNameError] = useState(''); 
	const [emailError, setEmailError] = useState('');
	const [phoneNumberError, setPhoneNumberError] = useState('');
	const [messageType, setMessageType] =  useState('');


    useEffect(() => {
        const fetchGenders = async () => {
            try {
                const response = await fetch('/members/genders');
                const data = await response.json();
                setGenders(data);
                if (data.length > 0) {
                    setMemberData(prev => ({ ...prev, gender: data[0].code }));
                }
            } catch (error) {
                setMessage('Failed to fetch gender options.');
            }
        };
        fetchGenders();
    }, []);

    const handleChange = (e) => {
        const { name, value } = e.target;
        setMemberData(prev => ({ ...prev, [name]: value }));
    };

    const handleSubmit = async (e) => {
        e.preventDefault();
		
		setNameError('')
		setEmailError('')
		setPhoneNumberError('')
		setMessageType('success');

		
		if (!memberData.name || memberData.name.length < 5) {
		      setNameError('name must be at least 5 characters');
		      return;
	    }
		
		if(!/^[A-Za-z\s]+$/.test(memberData.name)){
			setNameError('name must be only characters');
		    return;
		}
		
	    if (!memberData.email || memberData.email.length < 5) {
	      setEmailError('Enter a Email address');
	      return;
	    }
		
		if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(memberData.email)){
			setEmailError('Enter a valid email');
		    return;
		}
		
		if (!memberData.phoneNumber || memberData.phoneNumber.length < 10) {
	       setPhoneNumberError('Enter a phonenumber');
	      return;
	    }
		
		if(!/^[1-9][0-9]{9}$/.test(memberData.phoneNumber)){
			setPhoneNumberError('Enter a valid phoneNumber sholud only contains numbers ');
		    return;
		}
		
		
        setMessage('Adding member...');

        const memberDataToSend = {
            ...memberData,
            phoneNumber: parseInt(memberData.phoneNumber, 10),
        };

        try {
            const response = await fetch('/members/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(memberDataToSend),
            });

            if (response.ok) {
                setMessage('Member added successfully!');
                setMemberData({
                    name: '',
                    email: '',
                    phoneNumber: '',
                    gender: genders[0]?.code || '',
                    address: ''
                });
            } else {
				const errorData = await response.json();
				setMessage(`Error: ${errorData.message}`);
				setMessageType('error');
            }
        } catch (error) {
            setMessage('Error adding member.');
        }
    };

    return (
        <div className="container">
            <div className="form-container">
                <h2>Add New Member</h2>
                <form onSubmit={handleSubmit} className="form">
                    <div className="form-group">
                        <label htmlFor="name">Name:</label>
                        <input type="text" id="name" name="name" value={memberData.name} onChange={handleChange} required placeholder="Enter Name..."/>
						{ nameError && <span style={{ color: 'red', fontSize: '12px' }}>{nameError}</span> }

						</div>
                    <div className="form-group">
                        <label htmlFor="email">Email:</label>
                        <input type="text" id="email" name="email" value={memberData.email} onChange={handleChange} required placeholder="Enter Email..." />
						{ emailError && <span style={{ color: 'red', fontSize: '12px' }}>{emailError}</span> }

						</div>
                    <div className="form-group">
                        <label htmlFor="phoneNumber">Phone Number:</label>
                        <input type="text" id="phoneNumber" name="phoneNumber" value={memberData.phoneNumber} onChange={handleChange} required placeholder="Enter Phone number..."/>
						{ phoneNumberError && <span style={{ color: 'red', fontSize: '12px' }}>{phoneNumberError}</span> }

						</div>
                    <div className="form-group">
                        <label>Gender:</label>
                        <div className="gender-options">
                            {genders.map(g => (
                                <React.Fragment key={g.code}>
                                    <input
                                        type="radio"
                                        id={g.code}
                                        name="gender"
                                        value={g.code}
                                        checked={memberData.gender === g.code}
                                        onChange={handleChange}
                                        required
                                    />
                                    <label htmlFor={g.code}>{g.displayName}</label>
                                </React.Fragment>
                            ))}
                        </div>
                    </div>
                    <div className="form-group">
                        <label htmlFor="address">Address:</label>
                        <input type="text" id="address" name="address" value={memberData.address} onChange={handleChange}  placeholder="Enter Address.."/>
                    </div>
                    <button type="submit" className="submit-btn">Add Member</button>
                </form>
				{message && <p className="update-member__message" style={{ color: messageType === 'error' ? 'red' : 'green' }}>{message}</p>}
            </div>
        </div>
    );
};

export default AddMember;