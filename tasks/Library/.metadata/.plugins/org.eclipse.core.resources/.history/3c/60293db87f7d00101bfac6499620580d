package com.users.Users.controllers;

import java.time.LocalDateTime;
import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.ResponseBody;

import com.users.Users.model.User;
import com.users.Users.service.MainUserService;

@Controller
@RequestMapping("/main/user")
public class MainUserController {
	
private MainUserService mainUserService;
	
	@Autowired
	public MainUserController(MainUserService mainUserService) {
		this.mainUserService=mainUserService;
	}
	
	@GetMapping("/getMainUsers")
	@ResponseBody
	public List<User> getMainUsers(){
		return mainUserService.getMainUsers();
	}
	
	
	@PutMapping("/update/{userId}")
	public ResponseEntity<?> updateUser(@PathVariable("userId") int userId) {
	    List<User> users = mainUserService.getUserById(userId);
	    if (users == null || users.isEmpty()) {
	        return ResponseEntity.status(HttpStatus.NOT_FOUND).body("User not found");
	    }

	    User user = users.get(0);
	    user.setAprovedStatus("Aproved");
	    user.setUpdated_at(LocalDateTime.now());

	    boolean change = mainUserService.updateUser(user);
	    if (!change) {
	        return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("No changes saved");
	    }
	    
	    mainUserService.addUserToMain(user);
	    return ResponseEntity.ok(true);
	}


}
