 body {
 	 font-family: Arial, sans-serif;
   	 background-color: #f4f4f4;
     align-items: center;
     justify-content: center;
     height: 100vh;
     margin: auto;
 }
.container {
	align-items: center;
    max-width: 600px;
    width: 100%;
    padding: 20px;
    box-sizing: border-box;
    margin-left:800px;
}

.form-container {
    background: #fff;
    padding: 40px;
    border-radius: 10px;
}

h2 {
    text-align: center;
    color: #333;
    margin-bottom: 20px;
}

.form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 15px;
}

/* .form-group, .form-row {
    display: flex;
    flex-direction: column;
} */

.form-group label, .form-row label {
    margin-bottom: 8px;
    color: #555;
    font-weight: bold;
}

.form-group input, .form-group select, .form-row select {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 5px;
    box-sizing: border-box;
    font-size: 16px;
    transition: border-color 0.3s;
}

.form-group input:focus, .form-group select:focus, .form-row select:focus {
    border-color: #007bff;
    outline: none;
}

.submit-btn {
    background-color: #6c757d;
    color: white;
    padding: 15px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 18px;
    font-weight: bold;
    margin-top: 10px;
    transition: background-color 0.3s;
}

.submit-btn:hover {
    background-color: #5a6268;
}

.message {
    text-align: center;
    margin-top: 20px;
    padding: 10px;
    border-radius: 5px;
    font-weight: bold;
}

 @media (min-width: 480px) {
    .form {
        grid-template-columns: 1fr 1fr;
    }

    .form-group.full-width, .submit-btn {
        grid-column: span 2;
    }
}

@media (max-width: 480px) {
    .form-container {
        padding: 20px;
    }
} 