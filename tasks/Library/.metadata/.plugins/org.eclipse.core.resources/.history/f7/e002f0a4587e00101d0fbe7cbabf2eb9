package com.users.Users.service.interfaces;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.users.Users.model.User;
import com.users.Users.repository.MainUserRepository;

@Service
public class MainUserService {
	
	private MainUserRepository mainUserRepository;
	
	@Autowired
	public MainUserService(MainUserRepository mainUserRepository) {
		this.mainUserRepository=mainUserRepository;
	}

	public void addUserToMain(User user) {
		mainUserRepository.addUserToMain(user);
	}

	public List<User> getMainUsers() {
		return mainUserRepository.getMainUsers();
	}


}
