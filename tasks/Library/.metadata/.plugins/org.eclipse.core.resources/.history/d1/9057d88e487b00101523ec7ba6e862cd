import React, { useState } from 'react';
import Navbar from './components/Navbar';
import AddBook from './components/AddBook';
import ViewBooks from './components/ViewBooks';
import UpdateBook from './components/UpdateBook';
import HomePage from './components/HomePage';
import AddMember from './components/AddMember';
import ViewMembers from './components/ViewMembers';
import UpdateMember from './components/UpdateMember';
import './App.css';

const App = () => {
  const [currentPage, setCurrentPage] = useState('home');
  const [bookToUpdateId, setBookToUpdateId] = useState(null);
  const [memberToUpdateId, setMemberToUpdateId] = useState(null);

  const handleNavigate = (page, id = null) => {
    setCurrentPage(page);
    setBookToUpdateId(page === 'updateBook' ? id : null);
    setMemberToUpdateId(page === 'updateMember' ? id : null);
  };

  const renderPage = () => {
    switch (currentPage) {
      case 'home':
        return <HomePage />;
      case 'addBook':
        return <AddBook />;
      case 'viewBooks':
        return <ViewBooks onUpdateClick={(bookId) => handleNavigate('updateBook', bookId)} />;
      case 'updateBook':
        return <UpdateBook bookId={bookToUpdateId} />;
      case 'addMember':
        return <AddMember />;
      case 'viewMembers':
        return <ViewMembers onUpdateClick={(memberId) => handleNavigate('updateMember', memberId)} />;
      case 'updateMember':
        // Pass the onNavigate function to the UpdateMember component
        return <UpdateMember memberId={memberToUpdateId} onNavigate={handleNavigate} />;
      default:
        return <HomePage />;
    }
  };

  return (
    <div>
      <Navbar onNavigate={handleNavigate} />
      {renderPage()}
    </div>
  );
};

export default App;