/* Root wrapper sits inside .appnav-content from your layout */
.adduser-page {
  padding: 24px;
  min-height: calc(100vh - var(--appnav-header-h, 64px));
  box-sizing: border-box;
}

/* Card */
.adduser-card {
  max-width: 980px;
  margin: 0 auto;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  box-shadow: 0 10px 24px rgba(0,0,0,0.06);
  padding: 20px;
}

.adduser-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
}

.adduser-title {
  font-size: 20px;
  margin: 0;
  color: #111827;
}

.adduser-badge {
  font-size: 12px;
  padding: 6px 10px;
  border-radius: 999px;
  border: 1px solid #d1d5db;
  background: #f9fafb;
  color: #374151;
}

/* Alert banner */
.adduser-alert {
  margin: 12px 0 16px;
  padding: 12px 14px;
  border-radius: 10px;
  font-weight: 600;
  font-size: 14px;
  border: 1px solid transparent;
}
.adduser-alert-success {
  background: #ecfdf5;
  color: #065f46;
  border-color: #a7f3d0;
}
.adduser-alert-error {
  background: #fef2f2;
  color: #991b1b;
  border-color: #fecaca;
}

/* Form & Grid */
.adduser-form {
  margin-top: 8px;
}

.adduser-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14px;
}

.adduser-col-span-2 {
  grid-column: span 1;
}

@media (min-width: 640px) {
  .adduser-grid {
    grid-template-columns: 1fr 1fr;
  }
  .adduser-col-span-2 {
    grid-column: span 2;
  }
}

/* Fields */
.adduser-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.adduser-field label {
  font-size: 13px;
  font-weight: 600;
  color: #374151;
}

.adduser-field input,
.adduser-field select {
  width: 100%;
  padding: 12px 12px;
  border: 1px solid #d1d5db;
  border-radius: 10px;
  background: #ffffff;
  font-size: 14px;
  color: #111827;
  transition: border-color .2s ease, box-shadow .2s ease;
  box-sizing: border-box;
}

.adduser-field input::placeholder {
  color: #9ca3af;
}

.adduser-field input:focus,
.adduser-field select:focus {
  outline: none;
  border-color: #60a5fa;
  box-shadow: 0 0 0 3px rgba(96,165,250,.25);
}

.adduser-field select:disabled {
  background: #f9fafb;
  color: #6b7280;
  cursor: not-allowed;
}

/* Actions */
.adduser-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 10px;
}

.adduser-submit {
  padding: 12px 18px;
  font-weight: 700;
  font-size: 15px;
  border: none;
  border-radius: 10px;
  background: #111827;
  color: #fff;
  cursor: pointer;
  transition: transform .05s ease, background .2s ease;
}

.adduser-submit:hover { background: #1f2937; }
.adduser-submit:active { transform: translateY(1px); }
.adduser-submit:disabled {
  opacity: .7;
  cursor: not-allowed;
}

