import React, { useState, useEffect } from 'react';
import './ViewBooks.css';

const ViewBooks = ({ onUpdateClick }) => {
  const [books, setBooks] = useState([]);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState(null);
  const [selectedBooks, setSelectedBooks] = useState([]);
  const [message, setMessage] = useState('');
  const [messageType, setMessageType] = useState('success');

  const renderEnum = (val) => {
    if (!val) return '';
    if (typeof val === 'string') return val;
    if (typeof val === 'object') return val.displayName || val.name || val.code || '';
    return '';
  };

  const isStatusInactive = (status) => {
    if (!status) return false;
    if (typeof status === 'string') return status.toUpperCase() === 'INACTIVE';
    if (typeof status === 'object') {
      const s = (status.code || status.name || status.displayName || '').toString().toUpperCase();
      return s === 'INACTIVE';
    }
    return false;
  };

  const isAvailabilityAvailable = (availability) => {
    if (!availability) return false;
    if (typeof availability === 'string') return availability.toUpperCase() === 'AVAILABLE';
    if (typeof availability === 'object') {
      const a = (availability.code || availability.name || availability.displayName || '').toString().toUpperCase();
      return a === 'AVAILABLE';
    }
    return false;
  };

  const fetchBooks = async () => {
    setIsLoading(true);
    setError(null);
    setMessage('');
    try {
      const response = await fetch('/books/getbooks');
      if (response.ok) {
        const data = await response.json();
        setBooks(data);
      } else {
        setError('Failed to fetch books.');
        setMessage('Error: Failed to fetch books.');
        setMessageType('error');
      }
    } catch (err) {
      setError('An error occurred. Check the server connection.');
      setMessage('Error: An error occurred. Check the server connection.');
      setMessageType('error');
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    fetchBooks();
  }, []);

  const handleSelectBook = (bookId) => {
    setSelectedBooks((prev) =>
      prev.includes(bookId) ? prev.filter((id) => id !== bookId) : [...prev, bookId]
    );
  };

  const handleSelectAll = (event) => {
    if (event.target.checked) {
      setSelectedBooks(books.map((b) => b.bookId));
    } else {
      setSelectedBooks([]);
    }
  };

  const handleUpdate = (bookId) => {
    onUpdateClick(bookId);
  };

  const handleDelete = async (bookId) => {
    if (!window.confirm(`Are you sure you want to delete book ID ${bookId}?`)) return;

    try {
      const response = await fetch(`/books/delete/${bookId}`, { method: 'DELETE' });
      if (response.ok) {
        setMessage(`Book ID ${bookId} deleted.`);
        setMessageType('success');
        fetchBooks();
        setSelectedBooks((prev) => prev.filter((id) => id !== bookId));
      } else {
        setMessage(`Failed to delete book ID ${bookId}.`);
        setMessageType('error');
      }
    } catch (err) {
      setMessage(`Error deleting book ID ${bookId}.`);
      setMessageType('error');
    }
  };

  const toggleAvailabilityForBook = async (book) => {
    if (isStatusInactive(book.status)) {
      return;
    }

    const currentAvail = book.availability;
    const currentlyAvailable = isAvailabilityAvailable(currentAvail);
    const newAvailabilityCode = currentlyAvailable ? 'ISSUED' : 'AVAILABLE';

    try {
      const response = await fetch('/books/changeAvailability', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ bookId: book.bookId, newAvailability: newAvailabilityCode })
      });

      if (response.ok) {
        setMessage(`Updated availability for book ID ${book.bookId} -> ${newAvailabilityCode}`);
        setMessageType('success');
        fetchBooks();
      } else {
        setMessage(`Failed to update availability for book ID ${book.bookId}.`);
        setMessageType('error');
      }
    } catch (err) {
      setMessage(`Error updating availability for book ID ${book.bookId}.`);
      setMessageType('error');
    }
  };

  const handleBooks = async () => {
    if (selectedBooks.length === 0) {
      alert('Please select books to delete.');
      return;
    }
    if (!window.confirm(`Are you sure you want to delete ${selectedBooks.length} selected books?`)) return;

    try {
      const response = await fetch('/books/deleteBooks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids: selectedBooks })
      });
      if (response.ok) {
        setMessage(`Deleted selected books: ${selectedBooks.join(', ')}`);
        setMessageType('success');
        setSelectedBooks([]);
        fetchBooks();
      } else {
        setMessage('Failed to delete selected books.');
        setMessageType('error');
      }
    } catch (err) {
      setMessage('Error deleting selected books.');
      setMessageType('error');
    }
  };

  const updateAvailabilities = async () => {
    if (selectedBooks.length === 0) {
      alert('Please select books to update availability.');
      return;
    }
    if (!window.confirm(`Are you sure you want to update availability for ${selectedBooks.length} selected books?`)) return;

    try {
      const response = await fetch('/books/updateAvailabilityBatch', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids: selectedBooks })
      });
      if (response.ok) {
        setMessage(`Updated availability for selected books: ${selectedBooks.join(', ')}`);
        setMessageType('success');
        setSelectedBooks([]);
        fetchBooks();
      } else {
        setMessage('Failed to update availability for selected books.');
        setMessageType('error');
      }
    } catch (err) {
      setMessage('Error updating availability for selected books.');
      setMessageType('error');
    }
  };

  const handleBackToMain = () => {
    window.location.href = 'main';
  };

  if (isLoading) return <div className="loading-message">Loading books...</div>;
  if (error) return <div className="error-message">Error: {error}</div>;

  return (
    <div className="container">
      <h1 className="header">Available Books</h1>
      <p className="message-label" style={{ color: messageType === 'error' ? 'red' : 'green' }}>
        {message}
      </p>

      <div className="table-wrapper">
        <table className="books-table">
          <thead>
            <tr>
              <th className="checkbox-column">
                <input
                  type="checkbox"
                  onChange={handleSelectAll}
                  checked={books.length > 0 && selectedBooks.length === books.length}
                />
              </th>
              <th>Book ID</th>
              <th>Title</th>
              <th>Author</th>
              <th>Category</th>
              <th>Status</th>
              <th>Avail.</th>
              <th>Actions</th>
              <th>Avail. Action</th>
              <th>Created At</th>
              <th>Created By</th>
              <th>Updated At</th>
              <th>Updated By</th>
            </tr>
          </thead>
          <tbody>
            {books.length > 0 ? (
              books.map((book) => {
                const currentlyAvailable = isAvailabilityAvailable(book.availability);
                const newAvailabilityLabel = currentlyAvailable ? 'Mark Issued' : 'Mark Available';
                const disabledForStatus = isStatusInactive(book.status);
                return (
                  <tr key={book.bookId}>
                    <td className="checkbox-column">
                      <input
                        type="checkbox"
                        checked={selectedBooks.includes(book.bookId)}
                        onChange={() => handleSelectBook(book.bookId)}
                      />
                    </td>
                    <td>{book.bookId}</td>
                    <td>{book.title}</td>
                    <td>{book.author}</td>
                    <td>{renderEnum(book.category)}</td>
                    <td>{renderEnum(book.status)}</td>
                    <td>{renderEnum(book.availability)}</td>
                    <td className="actions-column">
                      <button onClick={() => handleUpdate(book.bookId)} className="action-button update-button">Update</button>
                      <button onClick={() => handleDelete(book.bookId)} className="action-button delete-button">Delete</button>
                    </td>
                    <td className="action-buttons">
                      <button onClick={() => toggleAvailabilityForBook(book)} disabled={disabledForStatus}>
                        {newAvailabilityLabel}
                      </button>
                    </td>
                    <td>{book.createdAt}</td>
                    <td>{book.createdBy}</td>
                    <td>{book.updatedAt}</td>
                    <td>{book.updatedBy}</td>
                  </tr>
                );
              })
            ) : (
              <tr>
                <td colSpan="13" className="no-books-message">
                  No books found in the library.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>

      <div className="button-group">
        <button onClick={updateAvailabilities} disabled={selectedBooks.length === 0}>
          Update Availability - Selected Books
        </button>
        <button onClick={handleBooks} disabled={selectedBooks.length === 0}>
          Delete Selected Books
        </button>
        <button onClick={fetchBooks}>
          Refresh Books
        </button>
        <button onClick={handleBackToMain}>
          Back to Main Menu
        </button>
      </div>
    </div>
  );
};

export default ViewBooks;