import React, { useState, useEffect } from 'react';

const AddBook = () => {
  const [categories, setCategories] = useState([]);
  const [statuses, setStatuses] = useState([]);
  const [availabilities, setAvailabilities] = useState([]);

  const [bookData, setBookData] = useState({
    bookId: null,
    title: '',
    author: '',
    category: '',
    status: '',
    availability: ''
  });

  const [message, setMessage] = useState('');
  const [isEditMode, setIsEditMode] = useState(false);

  useEffect(() => {
    const init = async () => {
      const editJson = sessionStorage.getItem('editBook');
      if (editJson) {
        try {
          const editBook = JSON.parse(editJson);
          populateFromBook(editBook);
          setIsEditMode(true);
        } catch (e) {
          console.warn('Invalid editBook in sessionStorage', e);
        } finally {
          sessionStorage.removeItem('editBook');
        }
      }

      const params = new URLSearchParams(window.location.search);
      const qBookId = params.get('bookId');

      try {
        const catData = [{ code: 'FICTION', displayName: 'Fiction' }, { code: 'NON-FICTION', displayName: 'Non-Fiction' }];
        const statusData = [{ code: 'ACTIVE', displayName: 'Active' }, { code: 'INACTIVE', displayName: 'Inactive' }];
        const availData = [{ code: 'AVAILABLE', displayName: 'Available' }, { code: 'ISSUED', displayName: 'Issued' }];

        setCategories(catData);
        setStatuses(statusData);
        setAvailabilities(availData);

        setBookData(prev => ({
          ...prev,
          category: prev.category || (catData && catData[0] && catData[0].code) || '',
          status: prev.status || (statusData && statusData[0] && statusData[0].code) || '',
          availability: prev.availability || (availData && availData[0] && availData[0].code) || ''
        }));
      } catch (err) {
        console.error('Error loading dropdowns', err);
        setMessage('Error loading dropdowns');
      }

      if (qBookId && !isEditMode) {
        try {
          const all = [
            { bookId: 1, title: 'Mock Book 1', author: 'Author 1', category: { code: 'FICTION' }, status: { code: 'ACTIVE' }, availability: { code: 'AVAILABLE' } },
            { bookId: 2, title: 'Mock Book 2', author: 'Author 2', category: { code: 'NON-FICTION' }, status: { code: 'ACTIVE' }, availability: { code: 'ISSUED' } },
          ];
          const found = all.find(b => String(b.bookId) === String(qBookId));
          if (found) {
            populateFromBook(found);
            setIsEditMode(true);
          } else {
            console.warn('No book found with id', qBookId);
            setMessage(`No book found with id ${qBookId}`);
          }
        } catch (err) {
          console.error('Error fetching books for edit', err);
          setMessage('Error fetching book data for edit.');
        }
      }
    };

    init();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const populateFromBook = (book) => {
    if (!book) return;
    setBookData({
      bookId: book.bookId ?? null,
      title: book.title ?? '',
      author: book.author ?? '',
      category: (typeof book.category === 'object' ? book.category.code : book.category) || '',
      status: (typeof book.status === 'object' ? book.status.code : book.status) || '',
      availability: (typeof book.availability === 'object' ? book.availability.code : book.availability) || ''
    });
  };

  const handleChange = (e) => {
    const { name, value } = e.target;
    setBookData(prev => ({ ...prev, [name]: value }));
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setMessage(isEditMode ? 'Updating book...' : 'Adding book...');

    try {
      setTimeout(() => {
        setMessage(isEditMode ? 'Book updated successfully!' : 'Book added successfully!');
        if (!isEditMode) {
          setBookData({
            bookId: null,
            title: '',
            author: '',
            category: categories[0]?.code || '',
            status: statuses[0]?.code || '',
            availability: availabilities[0]?.code || ''
          });
        }
      }, 1000);
    } catch (err) {
      console.error('Submit error', err);
      setMessage('Network/server error');
    }
  };
  
  // Converted BEM CSS classes to inline styles to ensure the component is self-contained and runnable.
  const styles = {
    container: {
      fontFamily: 'Segoe UI, Tahoma, Geneva, Verdana, sans-serif',
      padding: '30px',
      backgroundColor: '#e9ebee',
      minHeight: '100vh',
      display: 'flex',
      justifyContent: 'center',
      alignItems: 'center',
    },
    formContainer: {
      backgroundColor: '#ffffff',
      padding: '40px',
      borderRadius: '12px',
      boxShadow: '0 10px 25px rgba(0, 0, 0, 0.1)',
      width: '100%',
      maxWidth: '450px',
      transition: 'transform 0.3s ease-in-out',
    },
    heading: {
      fontSize: '2rem',
      fontWeight: '600',
      marginBottom: '30px',
      textAlign: 'center',
      color: '#333',
    },
    form: {
      display: 'flex',
      flexDirection: 'column',
      gap: '20px',
    },
    formGroup: {
      display: 'flex',
      flexDirection: 'column',
    },
    label: {
      marginBottom: '8px',
      fontWeight: '600',
      color: '#555',
      fontSize: '0.9rem',
    },
    input: {
      width: '100%',
      padding: '12px',
      border: '1px solid #ddd',
      borderRadius: '8px',
      fontSize: '1rem',
    },
    select: {
      width: '100%',
      padding: '12px',
      border: '1px solid #ddd',
      borderRadius: '8px',
      fontSize: '1rem',
    },
    submitBtn: {
      width: '100%',
      padding: '15px',
      backgroundColor: '#007bff',
      color: '#fff',
      border: 'none',
      borderRadius: '8px',
      cursor: 'pointer',
      fontWeight: '600',
      fontSize: '1.1rem',
      transition: 'background-color 0.3s ease',
      boxShadow: '0 4px 6px rgba(0, 123, 255, 0.2)',
    },
    message: {
      marginTop: '20px',
      textAlign: 'center',
      fontSize: '1rem',
      fontWeight: '500',
    },
  };

  return (
    <div style={styles.container}>
      <div style={styles.formContainer}>
        <h2 style={styles.heading}>{isEditMode ? 'Update Book' : 'Add a New Book'}</h2>
        <form onSubmit={handleSubmit} style={styles.form}>
          <div style={styles.formGroup}>
            <label htmlFor="title" style={styles.label}>Title</label>
            <input name="title" id="title" value={bookData.title} onChange={handleChange} required style={styles.input} />
          </div>

          <div style={styles.formGroup}>
            <label htmlFor="author" style={styles.label}>Author</label>
            <input name="author" id="author" value={bookData.author} onChange={handleChange} required style={styles.input} />
          </div>

          <div style={styles.formGroup}>
            <label htmlFor="category" style={styles.label}>Category</label>
            <select name="category" id="category" value={bookData.category} onChange={handleChange} required style={styles.select}>
              <option value="" disabled>Select category</option>
              {categories.map(cat => (
                <option key={cat.code} value={cat.code}>{cat.displayName}</option>
              ))}
            </select>
          </div>

          <div style={styles.formGroup}>
            <label htmlFor="status" style={styles.label}>Status</label>
            <select name="status" id="status" value={bookData.status} onChange={handleChange} required style={styles.select}>
              <option value="" disabled>Select status</option>
              {statuses.map(s => (
                <option key={s.code} value={s.code}>{s.displayName}</option>
              ))}
            </select>
          </div>

          <div style={styles.formGroup}>
            <label htmlFor="availability" style={styles.label}>Availability</label>
            <select name="availability" id="availability" value={bookData.availability} onChange={handleChange} required style={styles.select}>
              <option value="" disabled>Select availability</option>
              {availabilities.map(a => (
                <option key={a.code} value={a.code}>{a.displayName}</option>
              ))}
            </select>
          </div>

          <button type="submit" style={styles.submitBtn}>
            {isEditMode ? 'Update Book' : 'Add Book'}
          </button>
        </form>

        {message && <p style={styles.message}>{message}</p>}
      </div>
    </div>
  );
};

export default AddBook;
