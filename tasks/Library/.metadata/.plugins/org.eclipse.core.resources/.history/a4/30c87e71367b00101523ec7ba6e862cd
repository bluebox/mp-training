.home-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    background-color: #f4f4f4;
    text-align: center;
}

.content-box {
    padding: 40px;
    background-color: #ffffff;
    border-radius: 10px;
    max-width: 600px;
}

.main-heading {
    font-size: 2.5em;
    color: #333;
    margin-bottom: 10px;
}