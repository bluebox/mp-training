import React, { useState, useEffect } from 'react';
import './AddBook.css';

const AddBook = () => {
  const [categories, setCategories] = useState([]);
  const [statuses, setStatuses] = useState([]);
  const [availabilities, setAvailabilities] = useState([]);
  const [titleError, setTitleError] = useState(''); 
  const [authorError, setAuthorError] = useState('');

  const [bookData, setBookData] = useState({
    bookId: null,
    title: '',
    author: '',
    category: '',
    status: '',
    availability: ''
  });

  const [message, setMessage] = useState('');
  
  useEffect(() => {
    const init = async () => {
      try {
        const [catRes, statusRes, availRes] = await Promise.all([
          fetch('/books/bookcategories'),
          fetch('/books/bookstatuses'),
          fetch('/books/bookavailabilities')
        ]);
        const [catData, statusData, availData] = await Promise.all([
          catRes.json(),
          statusRes.json(),
          availRes.json()
        ]);

        setCategories(catData || []);
        setStatuses(statusData || []);
        setAvailabilities(availData || []);

        setBookData(prev => ({
          ...prev,
          category: prev.category || (catData && catData[0] && catData[0].code) || '',
          status: prev.status || (statusData && statusData[0] && statusData[0].code) || '',
          availability: prev.availability || (availData && availData[0] && availData[0].code) || ''
        }));
      } catch (err) {
        console.error('Error loading dropdowns', err);
        setMessage('Error loading dropdowns');
      }
    };

    init();
  }, []);

  const handleChange = (e) => {
    const { name, value } = e.target;
    setBookData(prev => ({ ...prev, [name]: value }));
  };
  
  
  const handleSubmit = async (e) => {
    e.preventDefault();

    // clear previous state/errors
    setMessage('');
    setTitleError('');
    setAuthorError('');
    setLoading(true);

    const url = '/books/add';
    const payload = {
      title: bookData.title,
      author: bookData.author,
      category: bookData.category,
      status: bookData.status,
      availability: bookData.availability
    };

    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      // Try to parse JSON safely. Some error responses aren't JSON.
      let data = null;
      try {
        data = await res.json();
      } catch (parseErr) {
        // ignore parse error, we'll handle based on status
        console.warn('Response not JSON', parseErr);
      }

      if (!res.ok) {
        // If backend returns validation errors in structured form
        if (data && data.fieldErrors) {
          data.fieldErrors.forEach(fieldError => {
            if (fieldError.field === 'title') {
              setTitleError(fieldError.message);
            }
            if (fieldError.field === 'author') {
              setAuthorError(fieldError.message);
            }
            // add other field mappings if needed (category, status, availability)
          });
          setMessage('Please fix the validation errors and try again.');
        } else {
          // Generic server error
          const serverText = data && data.message ? data.message : `${res.status} ${res.statusText}`;
          setMessage(`Server error: ${serverText}`);
        }
        setLoading(false);
        return;
      }

      // success path
      setMessage((data && data.message) ? data.message : 'Book added successfully!');
      // reset the form to defaults (safe fallback to first dropdown options)
      setBookData({
        bookId: null,
        title: '',
        author: '',
        category: categories[0]?.code || '',
        status: statuses[0]?.code || '',
        availability: availabilities[0]?.code || ''
      });
    } catch (err) {
      console.error('Submit error', err);
      setMessage('Submit error — check console for details');
    } finally {
      setLoading(false);
    }
  };

  
