package com.LMS.LibMS.repository.interfaceImpl;

import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.jdbc.core.namedparam.MapSqlParameterSource;
import org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate;
import org.springframework.stereotype.Repository;

import com.LMS.LibMS.model.IssueRecord;
import com.LMS.LibMS.model.enums.IssueStatus;
import com.LMS.LibMS.repository.interfaces.IssueRecordRepository;
import com.LMS.LibMS.rowmapper.IssueRecordRowMapper;

@Repository
public class IssueRecordRepositoryImpl implements IssueRecordRepository {

    private final NamedParameterJdbcTemplate namedParameterJdbcTemplate;

    @Autowired
    public IssueRecordRepositoryImpl(NamedParameterJdbcTemplate namedParameterJdbcTemplate) {
        this.namedParameterJdbcTemplate = namedParameterJdbcTemplate;
    }

    @Override
    public void addIssueRecord(IssueRecord issueRecord) {
        // ✅ Use camelCase column names to match your schema/RowMapper
        String sql = "INSERT INTO issue_records " +
                "(bookId, memberId, status, issueDate, issuedBy) " +
                "VALUES (:bookId, :memberId, :status, :issueDate, :issuedBy)";

        MapSqlParameterSource params = new MapSqlParameterSource()
                .addValue("bookId", issueRecord.getBookId())
                .addValue("memberId", issueRecord.getMemberId())
                .addValue("status", issueRecord.getStatus().getCode())
                .addValue("issueDate", issueRecord.getIssueDate())
                .addValue("issuedBy", issueRecord.getIssuedBy());

        namedParameterJdbcTemplate.update(sql, params);
    }

    @Override
    public boolean updateIssueRecord(IssueRecord issueRecord) {
        // ✅ Use camelCase column names here too
        String sql = "UPDATE issue_records SET " +
                "status = :status, " +
                "returnDate = :returnDate, " +
                "returnedBy = :returnedBy " +
                "WHERE issueId = :issueId";

        MapSqlParameterSource params = new MapSqlParameterSource()
                .addValue("issueId", issueRecord.getIssueId())
                .addValue("status", issueRecord.getStatus().getCode())
                .addValue("returnDate", issueRecord.getReturnDate())
                .addValue("returnedBy", issueRecord.getReturnedBy());

        int rows = namedParameterJdbcTemplate.update(sql, params);
        return rows > 0;
    }

    @Override
    public List<IssueRecord> getAllIssuedRecords() {
        String sql = "SELECT * FROM issue_records";
        return namedParameterJdbcTemplate.query(sql, new IssueRecordRowMapper());
    }

    @Override
    public Optional<IssueRecord> getActiveIssueRecordByBookId(int bookId) {
        String sql = "SELECT * FROM issue_records " +
                "WHERE bookId = :bookId AND status = :status AND returnDate IS NULL";

        MapSqlParameterSource params = new MapSqlParameterSource()
                .addValue("bookId", bookId)
                .addValue("status", IssueStatus.ISSUED.getCode());

        List<IssueRecord> records = namedParameterJdbcTemplate.query(sql, params, new IssueRecordRowMapper());
        return records.stream().findFirst();
    }
}
