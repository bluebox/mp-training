/* ViewUserRequests.css */
/* Everything is contained within .members-container to avoid leaking styles. */
/* The .appnav-content class ensures it sits to the right of your fixed sidebar and below the header. */

.members-loading,
.members-error {
  padding: 24px;
}

.members-container {
  padding: 24px;
  min-height: calc(100vh - var(--appnav-header-h, 64px));
  background-color: #f4f4f4;
  box-sizing: border-box;
  margin-top:50px;
}

.members-card {
  max-width: 1400px;
  margin: 0 auto;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  box-shadow: 0 10px 24px rgba(0,0,0,0.06);
  padding: 16px;
}

.members-topbar {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 12px;
  align-items: center;
  margin-bottom: 12px;
}

.members-header {
  font-size: 20px;
  margin: 0;
  text-align: left;
}

.right-section {
  display: flex;
  align-items: center;
}

.search-container {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.form-label {
  font-weight: 600;
  color: #374151;
  font-size: 14px;
}

.form-input {
  width: 260px;
  max-width: 60vw;
  padding: 10px 12px;
  border: 1px solid #d1d5db;
  border-radius: 10px;
  background: #ffffff;
  font-size: 14px;
  color: #111827;
  transition: border-color .2s ease, box-shadow .2s ease;
}
.form-input:focus {
  outline: none;
  border-color: #60a5fa;
  box-shadow: 0 0 0 3px rgba(96,165,250,.25);
}

/* Message banner */
.members-alert {
  margin: 8px 0 12px;
  padding: 10px 12px;
  border-radius: 10px;
  font-weight: 600;
  font-size: 14px;
  border: 1px solid transparent;
}
.members-alert-success {
  background: #ecfdf5;
  color: #065f46;
  border-color: #a7f3d0;
}
.members-alert-error {
  background: #fef2f2;
  color: #991b1b;
  border-color: #fecaca;
}

.table-wrapper {
  overflow: auto;
  background-color: #fff;
  border-radius: 12px;
  border: 1px solid #e5e7eb;
  max-height: calc(100vh - 64px - 24px - 220px);
}

/* Table styles (existing, refined and scoped) */
.members-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  min-width: 1000px;
}

/* Sticky header for better UX on long lists */
.members-table thead th {
  position: sticky;
  top: 0;
  background-color: #f8fafc; /* soft header bg */
  z-index: 1;
}

.members-table th, .members-table td {
  border-bottom: 1px solid #e5e7eb;
  padding: 12px;
  text-align: left;
  font-size: 14px;
}

.members-table thead tr {
  background-color: #f3f4f6;
  color: #374151;
  text-transform: uppercase;
  font-size: 12px;
  letter-spacing: 0.02em;
}

.members-table tbody tr:nth-child(even) {
  background-color: #fafafa;
}

.members-table tbody tr:hover {
  background-color: #f1f5f9;
}

/* Keep actions on one line */
.view-members-actions-column {
  white-space: nowrap;
}

/* Buttons: reuse existing class names, just polish visuals */
.update-btn,
.delete-btn,
.delete-batch-btn,
.refresh-btn,
.back-btn {
  padding: 8px 12px;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 700;
  transition: transform .05s ease, background .2s ease, opacity .2s ease;
}

.update-btn {
  color: #fff;
  background-color: #3b82f6;
  margin-right: 6px;
}
.update-btn:hover { background-color: #2563eb; }
.update-btn:disabled {
  cursor: not-allowed;
  opacity: .6;
}

.delete-btn {
  color: #fff;
  background-color: #ef4444;
  margin-right: 6px;
}
.delete-btn:hover { background-color: #dc2626; }
.delete-btn:disabled {
  cursor: not-allowed;
  opacity: .6;
}

/* Bottom action bar */
.button-group {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 14px;
}

.delete-batch-btn,
.refresh-btn,
.back-btn {
  background-color: #111827;
  color: #fff;
}
.delete-batch-btn:hover,
.refresh-btn:hover,
.back-btn:hover {
  background-color: #1f2937;
}
.delete-batch-btn:disabled {
  cursor: not-allowed;
  opacity: .7;
}

/* Small status under table (your existing element) */
.message-label {
  margin-top: 8px;
  font-weight: 600;
  text-align: right;
  color: #065f46; /* overridden in JSX when error, but we keep neutral here */
}

/* Responsive tweaks */
@media (max-width: 768px) {
  .members-topbar {
    grid-template-columns: 1fr;
    gap: 8px;
  }
  .right-section {
    justify-content: flex-start;
  }
  .form-input {
    width: 100%;
    max-width: 100%;
  }
  .table-wrapper {
    max-height: calc(100vh - 64px - 24px - 280px);
  }
}
