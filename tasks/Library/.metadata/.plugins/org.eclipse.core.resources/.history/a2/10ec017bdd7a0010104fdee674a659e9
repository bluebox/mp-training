/* Block: add-book__container */
.add-book__container {
  font-family: Arial, sans-serif;
  padding: 20px;
  background-color: #f0f0f0;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* Block: add-book__form-container */
.add-book__form-container {
  background-color: #fff;
  padding: 20px;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  width: 100%;
  max-width: 400px;
}

/* Element: add-book__form-heading */
.add-book__form-heading {
  font-size: 1.5rem;
  font-weight: bold;
  margin-bottom: 20px;
  text-align: center;
}

/* Block: add-book__form */
.add-book__form {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

/* Element: add-book__form-group */
.add-book__form-group {
  display: flex;
  flex-direction: column;
}

/* Element: add-book__label */
.add-book__label {
  margin-bottom: 5px;
  font-weight: bold;
}

/* Element: add-book__input, add-book__select */
.add-book__input,
.add-book__select {
  width: 100%;
  padding: 8px;
  border: 1px solid #ccc;
  border-radius: 4px;
}

/* Element: add-book__submit-btn */
.add-book__submit-btn {
  width: 100%;
  padding: 10px;
  background-color: #007bff;
  color: #fff;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-weight: bold;
  transition: background-color 0.3s ease;
}

.add-book__submit-btn:hover {
  background-color: #0056b3;
}

/* Element: add-book__message */
.add-book__message {
  margin-top: 15px;
  text-align: center;
  font-size: 14px;
  color: #555;
}