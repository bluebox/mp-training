import React, { useState } from 'react';
import Navbar from './components/Navbar';
import AddBook from './components/AddBook';
import ViewBooks from './components/ViewBooks';
import UpdateBook from './components/UpdateBook';
import './App.css';

const App = () => {
  const [currentPage, setCurrentPage] = useState('view');
  const [bookToUpdateId, setBookToUpdateId] = useState(null);

  const handleNavigate = (page, bookId = null) => {
    setCurrentPage(page);
    setBookToUpdateId(bookId);
  };

  return (
    <div>
      <Navbar onNavigate={handleNavigate} />
      {currentPage === 'add' ? (
        <AddBook />
      ) : currentPage === 'update' ? (
        <UpdateBook bookId={bookToUpdateId} />
      ) : (
        <ViewBooks onUpdateClick={(bookId) => handleNavigate('update', bookId)} />
      )}
    </div>
  );
};

export default App;