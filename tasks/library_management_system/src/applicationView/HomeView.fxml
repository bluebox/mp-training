<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx"
           fx:controller="Controller.MenuController" prefWidth="1200.0" prefHeight="700.0">

   <!-- Full-screen background image -->
   <ImageView fitWidth="1200.0" fitHeight="700.0" preserveRatio="false" pickOnBounds="true">
      <image>
         <Image url="@download.jpg" />
      </image>
   </ImageView>

   <!-- Overlay content -->
   <VBox alignment="CENTER" spacing="20.0">
      <Label text="Library Management System" textFill="white">
         <font>
            <Font name="Segoe UI Bold" size="36.0" />
         </font>
      </Label>

      <Button text="Books" onAction="#getBooks" prefWidth="250.0" prefHeight="50.0"
              style="-fx-background-radius: 20; -fx-font-size: 18px; -fx-background-color: linear-gradient(to right, #64b3f4, #c2e59c); -fx-text-fill: white;" />

      <Button text="Members" onAction="#getMembers" prefWidth="250.0" prefHeight="50.0"
              style="-fx-background-radius: 20; -fx-font-size: 18px; -fx-background-color: linear-gradient(to right, #43cea2, #185a9d); -fx-text-fill: white;" />

      <Button text="Issue Records" onAction="#getIssuesRecords" prefWidth="250.0" prefHeight="50.0"
              style="-fx-background-radius: 20; -fx-font-size: 18px; -fx-background-color: linear-gradient(to right, #f7971e, #ffd200); -fx-text-fill: white;" />

      <Button text="Reports" onAction="#getReports" prefWidth="250.0" prefHeight="50.0"
              style="-fx-background-radius: 20; -fx-font-size: 18px; -fx-background-color: linear-gradient(to right, #dd5e89, #f7bb97); -fx-text-fill: white;" />
   </VBox>
</StackPane>
