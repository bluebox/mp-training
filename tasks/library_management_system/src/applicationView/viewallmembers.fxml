<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="520.0" prefWidth="880.0"
            xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.ViewAllMembersController">

    <children>
        <!-- Background Image -->
         <ImageView fitWidth="1200.0" fitHeight="700.0" preserveRatio="false" pickOnBounds="true">
      <image>
         <Image url="@download.jpg" />
      </image>
   </ImageView>

        <!-- Title Label -->
        <Label layoutX="400.0" layoutY="20.0" text="👥 Library Members List" style="-fx-text-fill: white;">
            <font>
                <Font name="Georgia Bold" size="24.0"/>
            </font>
        </Label>

        <!-- TableView -->
        <TableView fx:id="memberTable" layoutX="180.0" layoutY="80.0" prefHeight="420.0" prefWidth="920.0" style="-fx-background-radius: 10;">
            <columns>
                    <TableColumn fx:id="idCol" prefWidth="180.0" text="Member id"/>
            
                <TableColumn fx:id="nameCol" prefWidth="180.0" text="Member Name"/>
                <TableColumn fx:id="emailCol" prefWidth="200.0" text="Email"/>
                <TableColumn fx:id="mobileCol" prefWidth="160.0" text="Mobile"/>
                <TableColumn fx:id="addressCol" prefWidth="200.0" text="Address"/>
                <TableColumn fx:id="genderCol" prefWidth="150.0" text="Gender"/>
            </columns>
        </TableView>

        <!-- Buttons -->
        <Button layoutX="100.0" layoutY="650.0" fx:id="backButton" onAction="#handleBack" text="⬅ Back to Home" prefHeight="45.0" prefWidth="180.0"
                style="-fx-background-color: linear-gradient(to right, #ff7e5f, #feb47b); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;">
            <font>
                <Font name="Segoe UI Bold" size="16.0" />
            </font>
        </Button>

        <Button layoutX="540.0" layoutY="650.0" fx:id="addButton" onAction="#handleAddMember" text="➕ Add Member" prefHeight="45.0" prefWidth="180.0"
                style="-fx-background-color: linear-gradient(to right, #43cea2, #185a9d); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;">
            <font>
                <Font name="Segoe UI Bold" size="16.0" />
            </font>
        </Button>

        <Button layoutX="1000.0" layoutY="650.0" fx:id="updateButton" onAction="#handleUpdateMember" text="✏ Update Member" prefHeight="45.0" prefWidth="180.0"
                style="-fx-background-color: linear-gradient(to right, #8e2de2, #4a00e0); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;">
            <font>
                <Font name="Segoe UI Bold" size="16.0" />
            </font>
        </Button>
    </children>
</AnchorPane>