<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml" fx:controller="controllerr.BookFormController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <TextField fx:id="titleField" promptText="Title"/>
    <TextField fx:id="authorField" promptText="Author"/>
    <TextField fx:id="categoryField" promptText="Category"/>
    <ChoiceBox fx:id="statusChoiceBox" />
    <ChoiceBox fx:id="availabilityChoiceBox" />
    <Button text="Add Book" onAction="#handleAddBook"/>
    <Label fx:id="messageLabel"/>
</VBox>
