<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.library.controller.ViewIssuedBooksController"
      spacing="10" prefWidth="600" prefHeight="400">

    <TableView fx:id="issueTable" prefHeight="350" prefWidth="600">
        <columns>
            <TableColumn text="Book ID" fx:id="bookIdCol" />
            <TableColumn text="Member ID" fx:id="memberIdCol" />
            <TableColumn text="Issue Date" fx:id="issueDateCol" />
            <TableColumn text="Return Date" fx:id="returnDateCol" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <padding>
            <Insets top="0" right="10" bottom="10" left="0"/>
        </padding>
        <Button text="Back" fx:id="backButton" onAction="#handleBack"/>
    </HBox>

</VBox>
