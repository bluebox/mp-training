<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.library.controller.ViewBooksController"
            prefWidth="600" prefHeight="400">
    <TableView fx:id="table" layoutX="10" layoutY="10" prefWidth="580" prefHeight="380">
        <columns>
            <TableColumn fx:id="titleCol" text="Title" prefWidth="120"/>
            <TableColumn fx:id="authorCol" text="Author" prefWidth="100"/>
            <TableColumn fx:id="categoryCol" text="Category" prefWidth="100"/>
            <TableColumn fx:id="statusCol" text="Status" prefWidth="80"/>
            <TableColumn fx:id="availabilityCol" text="Availability" prefWidth="100"/>
        </columns>
    </TableView>
</AnchorPane>