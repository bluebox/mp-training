<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.library.controller.MemberController"
            prefWidth="400" prefHeight="400">

    <VBox spacing="10">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <TextField fx:id="name" promptText="Name" />
        <TextField fx:id="email" promptText="Email" />
        <TextField fx:id="mobile" promptText="Mobile Number" />

        <HBox spacing="10">
            <Label text="Gender:" />
            <RadioButton fx:id="male" text="Male" userData="M" />
            <RadioButton fx:id="female" text="Female" userData="F" />
            <RadioButton fx:id="other" text="Other" userData="O" />
        </HBox>

        <TextField fx:id="address" promptText="Address" />

        <Button text="Save" onAction="#saveMember" maxWidth="Infinity" />
    </VBox>
</AnchorPane>
