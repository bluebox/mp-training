<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllerr.UpdateBookAvailabilityController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <TextField fx:id="BookId" promptText="BookID"/>
    <ChoiceBox fx:id="availabilityBox"/>

    <Button text="Update Availability" onAction="#handleUpdateBookAvailability"/>
    <Label fx:id="messageLabel"/>
</VBox>
