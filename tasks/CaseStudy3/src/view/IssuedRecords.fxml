<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllerr.IssuedRecordsController">
    <Label text="📖 All Issued Records" style="-fx-font-size: 18px;" />
    <TableView fx:id="table">
        <columns>
            <TableColumn fx:id="issueIdCol" text="Issue ID" />
            <TableColumn fx:id="bookIdCol" text="Book ID" />
            <TableColumn fx:id="memberIdCol" text="Member ID" />
            <TableColumn fx:id="statusCol" text="Status" />
            <TableColumn fx:id="issueDateCol" text="Issue Date" />
            <TableColumn fx:id="returnDateCol" text="Return Date" />
        </columns>
    </TableView>
</VBox> 