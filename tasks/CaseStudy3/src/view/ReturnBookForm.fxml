<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllerr.ReturnBookFormController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Issue ID"/>
    <TextField fx:id="issueIdField" promptText="Issue ID"/>
    <Label text="Book ID"/>
    <TextField fx:id="bookIdField" promptText="Book ID"/>
    <Label text="Return Date"/>
    <DatePicker fx:id="returnDatePicker"/>
    <Button text="Return Book" onAction="#handleReturnBook"/>
    <Label fx:id="messageLabel"/>
</VBox> 