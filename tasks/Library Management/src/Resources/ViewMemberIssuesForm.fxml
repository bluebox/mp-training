<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" spacing="10" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #f0f0f0;">
    <Label text="View Member's Issued Books" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <Label text="Member ID"/>
    <TextField fx:id="memberIdField" promptText="Member ID"/>
    <TableView fx:id="issuesTable">
        <columns>
            <TableColumn fx:id="issueIdColumn" text="Issue ID"/>
            <TableColumn fx:id="bookIdColumn" text="Book ID"/>
            <TableColumn fx:id="issueDateColumn" text="Issue Date"/>
        </columns>
    </TableView>
    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10;">
        <Button text="View Issued Books" onAction="#handleViewMemberIssues" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
        <Button text="Clear" onAction="#handleClear" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
        <Button text="Back" onAction="#goBack" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
    </HBox>
</VBox>