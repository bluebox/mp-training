<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.*?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" spacing="10" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #f0f0f0;">
    <Label text="View/Update Members" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <TableView fx:id="membersTable">
        <columns>
            <TableColumn fx:id="memberIdColumn" text="Member ID"/>
            <TableColumn fx:id="nameColumn" text="Name"/>
            <TableColumn fx:id="emailColumn" text="Email"/>
            <TableColumn fx:id="mobileColumn" text="Mobile"/>
            <TableColumn fx:id="genderColumn" text="Gender"/>
            <TableColumn fx:id="addressColumn" text="Address"/>
        </columns>
    </TableView>
    <Label text="Member ID to Update"/>
    <TextField fx:id="memberIdField" promptText="Member ID to Update"/> 
    <Label text="New Name"/>
    <TextField fx:id="nameField" promptText="New Name"/>
    <Label text="New Email"/>
    <TextField fx:id="emailField" promptText="New Email"/>
    <Label text="New Mobile"/>
    <TextField fx:id="mobileField" promptText="New Mobile"/>
    <Label text="New Gender"/>
    <ComboBox fx:id="genderCombo" promptText="New Gender">
        <items>
            <FXCollections fx:factory="observableArrayList">
                <String fx:value="Male (M)"/>
                <String fx:value="Female (F)"/>
            </FXCollections>
        </items>
    </ComboBox>
    <Label text="New Address"/>
    <TextField fx:id="addressField" promptText="New Address"/>
    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10;">
        <Button text="Update Member" onAction="#handleUpdateMember" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
        <Button text="Clear" onAction="#handleClear" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
        <Button text="Back" onAction="#goBack" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
    </HBox>
</VBox>