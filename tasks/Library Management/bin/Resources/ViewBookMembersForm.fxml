<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" spacing="10" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #f0f0f0;">
    <Label text="View Members Who Used Book" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <TextField fx:id="bookIdField" promptText="Book ID"/>
    <TableView fx:id="membersTable">
        <columns>
            <TableColumn fx:id="memberIdColumn" text="Member ID"/>
            <TableColumn fx:id="issueDateColumn" text="Issue Date"/>
            <TableColumn fx:id="statusColumn" text="Status"/>
        </columns>
    </TableView>
    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10;">
        <Button text="View Members" onAction="#handleViewBookMembers" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
        <Button text="Clear" onAction="#handleClear" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
        <Button text="Back" onAction="#goBack" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
    </HBox>
</VBox>