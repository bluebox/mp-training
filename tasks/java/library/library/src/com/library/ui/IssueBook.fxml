<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.library.controller.IssueBookController"
            prefWidth="400" prefHeight="250">
    <children>
        <Label layoutX="30" layoutY="30" text="Book ID:"/>
        <TextField fx:id="bookIdField" layoutX="150" layoutY="25" prefWidth="200"/>

        <Label layoutX="30" layoutY="80" text="Member ID:"/>
        <TextField fx:id="memberIdField" layoutX="150" layoutY="75" prefWidth="200"/>

        <Button text="Issue Book" layoutX="150" layoutY="130" prefWidth="100" onAction="#handleIssueBook"/>

        <Label fx:id="statusLabel" layoutX="30" layoutY="180" prefWidth="340" style="-fx-text-fill: green;"/>
    </children>
</AnchorPane>