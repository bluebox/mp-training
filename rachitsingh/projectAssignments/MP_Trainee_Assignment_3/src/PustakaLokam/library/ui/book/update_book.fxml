<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
	fx:controller="PustakaLokam.library.controller.book.UpdateBookController">
	<VBox spacing="15" prefWidth = "400" prefHeight = "300">
		<padding>
			<Insets top="20" right="20" bottom="20" left="20" />
		</padding>

		<Label text="Update Book Details"
			style="-fx-font-size: 18px; -fx-font-weight: bold;" />

		<GridPane hgap="10" vgap="10">
			<columnConstraints>
				<ColumnConstraints halignment="RIGHT" />
				<ColumnConstraints />
			</columnConstraints>

			<Label text="Book ID:" GridPane.rowIndex="0"
				GridPane.columnIndex="0" />
			<TextField fx:id="bookIdField" promptText="Enter Book ID"
				GridPane.rowIndex="0" GridPane.columnIndex="1" />

			<Label text="Title:" GridPane.rowIndex="1"
				GridPane.columnIndex="0" />
			<TextField fx:id="titleField" promptText="Enter Title"
				GridPane.rowIndex="1" GridPane.columnIndex="1" />

			<Label text="Author:" GridPane.rowIndex="2"
				GridPane.columnIndex="0" />
			<TextField fx:id="authorField" promptText="Enter Author"
				GridPane.rowIndex="2" GridPane.columnIndex="1" />

			<Label text="Category:" GridPane.rowIndex="3"
				GridPane.columnIndex="0" />
			<TextField fx:id="categoryField"
				promptText="Enter Category" GridPane.rowIndex="3"
				GridPane.columnIndex="1" />
		</GridPane>

		<Button text="Update Book Details"
			onAction="#updateDetailsButtonHandler" />
		<Label fx:id="statusLabel" style="-fx-text-fill: green;" />

	</VBox>
</AnchorPane>
