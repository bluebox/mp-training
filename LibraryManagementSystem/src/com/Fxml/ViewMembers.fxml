<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
 
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.library.controller.ViewMembersController"
      spacing="10" style="-fx-padding: 20;">
    
    <Label text="All Members" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
 
    <TableView fx:id="memberTable" prefHeight="300">
        <columns>
            <TableColumn text="ID" fx:id="colId"/>
            <TableColumn text="Name" fx:id="colName"/>
            <TableColumn text="Email" fx:id="colEmail"/>
            <TableColumn text="Mobile" fx:id="colMobile"/>
            <TableColumn text="Gender" fx:id="colGender"/>
            <TableColumn text="Address" fx:id="colAddress"/>
        </columns>
    </TableView>
</VBox>