<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.ViewMembersController"
      spacing="10" alignment="CENTER" style="-fx-padding: 20;">

    <Label text="Members List" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

    <TableView fx:id="memberTable" prefWidth="500">
        <columns>
            <TableColumn fx:id="nameCol" text="Name" prefWidth="150"/>
            <TableColumn fx:id="emailCol" text="Email" prefWidth="180"/>
            <TableColumn fx:id="mobileCol" text="Mobile" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>
