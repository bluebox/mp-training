		this.namedParameterJdbcTemplate = namedParameterJdbcTemplate;
	}

	@Override
	public void addMember(Member member) {
		String sql = "insert into Member(name,email,mobile,gender,address) values :name,:email,:mobile,:gender,:address";
		MapSqlParameterSource params = new MapSqlParameterSource();
		params.addValue("name",member.getName());
		params.addValue("email",member.getEmail());
		params.addValue("mobile",member.getMobile());
		params.addValue("gender",member.getGender().getCode());
		params.addValue("address",member.getAddress());
		namedParameterJdbcTemplate.update(sql, params);
		
	}

