package com.casestudy.spring.library.api.controller;

import java.util.HashMap;
import java.util.Map;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.validation.Errors;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.casestudy.spring.library.beans.Book;
import com.casestudy.spring.library.impl.Implementation;

import jakarta.validation.Valid;

@RestController
@RequestMapping("/api/books")
public class BookControllerApi {
	Implementation impl;

	@Autowired
	public BookControllerApi(Implementation impl) {
		this.impl = impl;
	}

	@PostMapping("/addBook")
	public ResponseEntity<?>  AddBookToDb(@Valid @RequestBody Book book) {
		boolean flag = impl.addBook(book);
		Map<String,String> entity = new HashMap<>();
		if (flag == true) {
			entity.put("status","Success");
			entity.put("message", "Book Added Succesfully");
			return ResponseEntity.ok(entity);
		} else {
			entity.put("status","Error");
			entity.put("message", "Something Went Wrong");
			return ResponseEntity.internalServerError().body(entity);
		}

	}

	@PostMapping("/updateBook")
	public ResponseEntity<?> updateBook(@Valid @RequestBody Book book) {
		Map<String,String> entity = new HashMap<>();
		if(impl.findBookById(book)) {
				entity.put("status","Error");
				entity.put("message", "Book Not Found");
				return ResponseEntity.badRequest().body(entity);
		}
		boolean flag = impl.updateBookService(book);
		if (flag == true) {
			entity.put("status","Success");
			entity.put("message", "Book Updated Succesfully");
			return ResponseEntity.ok(entity);
		} else {
			entity.put("status","Error");
			entity.put("message", "Something Went Wrong");
			return ResponseEntity.internalServerError().body(entity);
		}
	}

	@GetMapping("/ViewAllBooks")
	public String showAllBooks(Model model) {
		model.addAttribute("books", impl.viewAllBooksService());
		return "Books/ShowAllBooks";
	}

}
