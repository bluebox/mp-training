package com.casestudy.spring.library.dao;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.jdbc.core.namedparam.MapSqlParameterSource;
import org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate;
import org.springframework.stereotype.Repository;

import com.casestudy.spring.library.beans.Member;
import com.casestudy.spring.library.dao.models.MembersDaoModel;
import com.casestudy.spring.library.rowmapper.MemberRowMapper;

@Repository
public class MembersDaoUsingJdbcTemplate implements MembersDaoModel{
	
	private NamedParameterJdbcTemplate namedParameterJdbcTemplate;
	
	@Autowired
	public MembersDaoUsingJdbcTemplate(NamedParameterJdbcTemplate namedParameterJdbcTemplate) {
		this.namedParameterJdbcTemplate = namedParameterJdbcTemplate;
	}

	@Override
	public void addMember(Member member) {
		String sql = "INSERT INTO Member(name,email,mobile,gender,address) values (:name,:email,:mobile,:gender,:address)";
		MapSqlParameterSource params = new MapSqlParameterSource();
		params.addValue("name",member.getName());
		params.addValue("email",member.getEmail());
		params.addValue("mobile",member.getMobile());
		params.addValue("gender",member.getGender().getCode());
		params.addValue("address",member.getAddress());
		namedParameterJdbcTemplate.update(sql, params);
		
	}

	@Override
	public boolean updateMember(Member member) {
		String backUp = "select memberID,name,email,mobile,gender,address from Member where memberId = :memberId";
		MapSqlParameterSource params = new MapSqlParameterSource();
		params.addValue("memberId",member.getMemberId());
		Member old = namedParameterJdbcTemplate.queryForObject(backUp, params,new MemberRowMapper());
		return false;
	}

	@Override
	public List<Member> getAllMembers() {
		String sql = "select memberID,name,email,mobile,gender,address from Member";
		MapSqlParameterSource params = new MapSqlParameterSource();
		return namedParameterJdbcTemplate.query(sql, params,new MemberRowMapper());
	}

	@Override
	public Member getMemberById(int id) {
		String sql = "select memberID,name,email,mobile,gender,address from Member where memberId = :memberId";
		MapSqlParameterSource params = new MapSqlParameterSource();
		params.addValue("memberId",id);
		return namedParameterJdbcTemplate.queryForObject(sql, params,new MemberRowMapper());
	}

	@Override
	public boolean findMember(int memberId) {
		String sql = "Select 1 from Member where memberId = :memberId";
		MapSqlParameterSource params = new MapSqlParameterSource();
		params.addValue("memberId", memberId);
		try {
			return namedParameterJdbcTemplate.queryForObject(sql, params, Integer.class)==1;
		}catch(Exception e) {
			return false;
		}
	}
	

}
