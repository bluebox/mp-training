<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" id="WebApp_ID" version="4.0">
  <display-name>servlet-initializations</display-name>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>index.xhtml</welcome-file>
    <welcome-file>default.html</welcome-file>
    <welcome-file>default.jsp</welcome-file>
    <welcome-file>default.htm</welcome-file>
    <welcome-file>default.xhtml</welcome-file>
  </welcome-file-list>
  
  
  <servlet>
  	<servlet-name>LazyInitializedServlet</servlet-name>
  	<servlet-class>dev.tulasidhar.servlets.LazyInitializedServlet</servlet-class>
  </servlet>
  <servlet-mapping>
  	<servlet-name>LazyInitializedServlet</servlet-name>
  	<url-pattern>/lazyServlet</url-pattern>
  </servlet-mapping>
  
  <servlet>
  	<servlet-name>PreInitializedServlet</servlet-name>
  	<servlet-class>dev.tulasidhar.servlets.PreInitializedServlet</servlet-class>
  	<load-on-startup>1</load-on-startup>
  </servlet>
  
  <servlet-mapping>
  	<servlet-name>PreInitializedServlet</servlet-name>
  	<url-pattern>/preInitServlet</url-pattern>
  </servlet-mapping>
  
</web-app>