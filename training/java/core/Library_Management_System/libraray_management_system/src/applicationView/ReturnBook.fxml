<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.ReturnBookController" prefHeight="200" prefWidth="400">
    <children>
        <VBox spacing="10" layoutX="50" layoutY="30">
            <TextField fx:id="issueIdField" promptText="Issue ID"/>
            <TextField fx:id="bookIdField" promptText="Book ID"/>
            <Button text="Return Book" onAction="#handleReturnBook"/>
        </VBox>
    </children>
</AnchorPane>