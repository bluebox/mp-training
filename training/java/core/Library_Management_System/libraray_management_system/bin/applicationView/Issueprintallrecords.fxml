<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.IssueprintallrecordsController">

    <children>
        <!-- Background Image -->
        <ImageView fitHeight="720.0" fitWidth="1280.0" layoutX="0.0" layoutY="0.0" preserveRatio="false">
            <image>
                <Image url="@download.jpg" />
            </image>
        </ImageView>

        <!-- Title Label -->
        <Label layoutX="440.0" layoutY="20.0" text="📚 Issued Books Record" style="-fx-text-fill: white;">
            <font>
                <Font name="Georgia Bold" size="24.0" />
            </font>
        </Label>

        <!-- TableView -->
        <TableView fx:id="issueTable" layoutX="180.0" layoutY="80.0" prefHeight="420.0" prefWidth="920.0" style="-fx-background-radius: 10;">
            <columns>
                <TableColumn fx:id="bookIdColumn" prefWidth="150.0" text="Book ID"/>
                <TableColumn fx:id="memberIdColumn" prefWidth="150.0" text="Member ID"/>
                <TableColumn fx:id="statusColumn" prefWidth="180.0" text="Status"/>
                <TableColumn fx:id="issueDateColumn" prefWidth="220.0" text="Issue Date"/>
                <TableColumn fx:id="returnDateColumn" prefWidth="220.0" text="Return Date"/>
            </columns>
        </TableView>

        <!-- Buttons -->
        <Button layoutX="100.0" layoutY="650.0" fx:id="backButton" onAction="#handleBackToHome" text="⬅ Back to Home" prefHeight="45.0" prefWidth="180.0"
                style="-fx-background-color: linear-gradient(to right, #ff7e5f, #feb47b); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;">
            <font>
                <Font name="Segoe UI Bold" size="16.0" />
            </font>
        </Button>

        <Button layoutX="540.0" layoutY="650.0" fx:id="issueButton" onAction="#handleIssueBook" text="📖 Issue Book" prefHeight="45.0" prefWidth="180.0"
                style="-fx-background-color: linear-gradient(to right, #43cea2, #185a9d); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;">
            <font>
                <Font name="Segoe UI Bold" size="16.0" />
            </font>
        </Button>

        <Button layoutX="1000.0" layoutY="650.0" fx:id="returnButton" onAction="#handleReturnBook" text="🔁 Return Book" prefHeight="45.0" prefWidth="180.0"
                style="-fx-background-color: linear-gradient(to right, #8e2de2, #4a00e0); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;">
            <font>
                <Font name="Segoe UI Bold" size="16.0" />
            </font>
        </Button>
    </children>
</AnchorPane>
