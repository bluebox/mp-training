<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.BookController">

   <!-- Background Image -->
   <children>
      <ImageView fitHeight="720.0" fitWidth="1280.0" layoutX="0.0" layoutY="0.0" pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@download.jpg" />
         </image>
      </ImageView>

      <!-- Title Label -->
      <Label layoutX="420.0" layoutY="20.0" text="📚 Library Management System - Books List" style="-fx-text-fill: white;">
         <font>
            <Font name="Georgia Bold" size="24.0" />
         </font>
      </Label>

      <!-- TableView -->
      <TableView fx:id="Book" layoutX="180.0" layoutY="80.0" prefHeight="420.0" prefWidth="920.0" style="-fx-background-radius: 10;">
         <columns>
            <TableColumn fx:id="BookId" prefWidth="100.0" text="Book Id" />
            <TableColumn fx:id="BookName" prefWidth="180.0" text="Book Name" />
            <TableColumn fx:id="Author" prefWidth="180.0" text="Author" />
            <TableColumn fx:id="Category" prefWidth="160.0" text="Category" />
            <TableColumn fx:id="Status" prefWidth="150.0" text="Status" />
            <TableColumn fx:id="Availability" prefWidth="150.0" text="Availability" />
         </columns>
      </TableView>

      <!-- Buttons -->
      <Button layoutX="100.0" layoutY="650.0" onAction="#gotoHome" text="⬅ Back to Home" prefHeight="45.0" prefWidth="180.0"
              style="-fx-background-color: linear-gradient(to right, #ff7e5f, #feb47b); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;">
         <font>
            <Font name="Segoe UI Bold" size="16.0" />
         </font>
      </Button>

      <Button layoutX="540.0" layoutY="650.0" onAction="#gotoAddBook" text="➕ Add Book" prefHeight="45.0" prefWidth="180.0"
              style="-fx-background-color: linear-gradient(to right, #43cea2, #185a9d); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;">
         <font>
            <Font name="Segoe UI Bold" size="16.0" />
         </font>
      </Button>

      <Button layoutX="1000.0" layoutY="650.0" onAction="#gotoUpdateBook" text="✏ Update Book" prefHeight="45.0" prefWidth="180.0"
              style="-fx-background-color: linear-gradient(to right, #8e2de2, #4a00e0); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;">
         <font>
            <Font name="Segoe UI Bold" size="16.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
