<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx/8.0.171"
            fx:controller="controller.SearchBookController"
            prefWidth="400" prefHeight="300">

    <VBox spacing="15" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">
        <Label text="Search Book" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <HBox spacing="10">
            <TextField fx:id="bookIdField" promptText="Enter Book ID" HBox.hgrow="ALWAYS"/>
            <Button text="Search" onAction="#onSearch"/>
        </HBox>

        <Separator/>

        <GridPane hgap="10" vgap="10">
            <Label text="Title:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="titleLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Author:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="authorLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Availability:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="statusLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>
</AnchorPane>
