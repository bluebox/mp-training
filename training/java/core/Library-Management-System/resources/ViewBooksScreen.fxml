<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="library.ui.ViewBooksScreen">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="All Books">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <TableView fx:id="booksTableView" prefHeight="400.0" prefWidth="900.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="selectColumn" minWidth="30.0" prefWidth="30.0" resizable="false" text="Select" /> <!-- NEW CHECKBOX COLUMN -->
            <TableColumn fx:id="bookIdColumn" text="Book ID" prefWidth="60.0" />
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="150.0" />
            <TableColumn fx:id="authorColumn" text="Author" prefWidth="120.0" />
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="80.0" />
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="60.0" />
            <TableColumn fx:id="availabilityColumn" text="Avail." prefWidth="60.0" />
            

            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="150.0" />
            <TableColumn fx:id="singleAvailabilityActionColumn" text="Avail. Action" prefWidth="100.0" />
            
            <TableColumn fx:id="createdAtColumn" text="Created At" prefWidth="140"/>
            <TableColumn fx:id="createdByColumn" text="Created By" prefWidth="80"/>
            <TableColumn fx:id="updatedAtColumn" text="Updated At" prefWidth="140"/>
            <TableColumn fx:id="updatedByColumn" text="Updated By" prefWidth="80"/>
        </columns>
         <columnResizePolicy>
             <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label fx:id="messageLabel" />
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button onAction="#handleRefreshBooks" text="Refresh Books" />
            <Button onAction="#handleDeleteSelectedBatch" text="Delete Selected Books" /> 
            <Button onAction="#handleBackToMainMenu" text="Back to Main Menu" />
         </children>
      </HBox>
   </children>
</VBox>