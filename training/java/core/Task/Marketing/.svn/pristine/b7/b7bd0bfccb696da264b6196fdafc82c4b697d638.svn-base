<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xml>
<configuration>
	<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${catalina.base}/logs/marketing.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${catalina.base}/logs/marketing.%d{yyyy-MM-dd}.gz</fileNamePattern>
		</rollingPolicy>
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} %-5level %X{REQUEST_ID} %logger{0} %M %L %m%n</pattern>
		</encoder>
	</appender>
	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} %-5level %X{REQUEST_ID} %logger{0} %M %L %m%n</pattern>
		</encoder>
	</appender>
	
	<appender name="USER_ACTIVITY" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${catalina.base}/logs/access_log_logout_marketing.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${catalina.base}/logs/access_log_logout_marketing.%d{yyyy-MM-dd}.gz
			</fileNamePattern>
		</rollingPolicy>
		<encoder>
			<pattern>&quot;%d{yyyy-MM-dd HH:mm:ss}&quot; - %msg%n</pattern>
		</encoder>
	</appender>
    <logger name="com.user.activity" level="INFO" additivity="false">
        <appender-ref ref="USER_ACTIVITY" />
    </logger>
    
	<logger name="com.medplus" level="INFO"/>
	<root level="INFO">
		<appender-ref ref="FILE" /> 
		<!-- <appender-ref ref="CONSOLE" /> -->
	</root>
</configuration>