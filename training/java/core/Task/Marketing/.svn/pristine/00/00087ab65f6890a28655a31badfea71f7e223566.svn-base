package com.medplus.marketing.constants;


public class CampaignConstants {

	public static final String ALL_CUSTOMERS = "Y";
	public static final String FEW_CUSTOMERS = "N";
	public static final String COUPON_BASED ="Y";
	public static final String NON_COUPON_BASED ="N";
	public static final String SPLIT_BY_STORE ="store";
	public static final String SPLIT_BY_PRODUCT ="product";
	public static final int MAX_CAMPAIGN_NAME_LEN = 50;

	public enum ApplicableType {
		PHARMACY(5), PATHLABS(6), LENS(7);
		private int type;
		
		ApplicableType(int type) {
			this.type = type;
		}

		public int getType() {
			return type;
		}
	}
	public enum PromotionType {
		CAMPAIGN, REGULAR, COMPLIMENTARY
	}
	
}
