	@GetMapping("get-pathlab-stores")
	public Response getPathlabStores(@RequestParam("citycode") String cityCode) {
		StoreSearchCriteria criteria = new StoreSearchCriteria();
		criteria.setCityCodeList(Arrays.asList(cityCode));
		return getActiveStoresInfo(criteria, true);
