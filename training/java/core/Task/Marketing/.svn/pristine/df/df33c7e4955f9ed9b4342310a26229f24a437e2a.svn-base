	private List<Option> getApplicableTypesByRoles(String type) {
		List<Option> userApplicableTypes = new ArrayList<>();
		List<Integer> createRole = new ArrayList<>();
		if(MULTIITEM.equalsIgnoreCase(type)) {
			createRole = MIC_ROLES.getApplicableTypesByViewRoles();
		} else if(REGULAR.equalsIgnoreCase(type)) {
			createRole = RP_ROLES.getApplicableTypesByViewRoles();
		} else if(CAMPAIGN.equalsIgnoreCase(type)) {
			createRole = CAMPAIGN_ROLES.getApplicableTypesByViewRoles();
		} else if(COMPLIMENTARY.equalsIgnoreCase(type)) {
			createRole = COMPLIMENTARY_ROLES.getApplicableTypesByViewRoles();
		}		
		
		if(createRole.contains(5)) {
			userApplicableTypes.add(FormHelper.createOption(PHARMACY, PHARMACY, "5", "pharmacy"));
		}
		if(createRole.contains(6)) {
			userApplicableTypes.add(FormHelper.createOption(PATHLABS, PATHLABS, "6", "pathlabs"));
		}
		if(createRole.contains(7)) {
			userApplicableTypes.add(FormHelper.createOption("Lens", "LENS", "7", "lens"));
		}
		return userApplicableTypes;
	}
	
	@GetMapping("get-campaign-info-form")
	public Response campaignInfoForm(@RequestParam(value = "type", required = false) String type, HttpServletRequest request, HttpServletResponse response) {
		Form campaignInfo = new Form("", "campaignInfo");
		
		InputElement campaignName = new InputElement(InputType.TEXT, "Campaign Name", "campaignName");
		campaignName.setClassName(MarketingCssHelper.createCssClass(Arrays.asList(COL_3_CLASS_NAME)));
		campaignName.setRegex(ALPHA_NUMERIC_REGEX);
		if(REGULAR.equals(type) || COMPLIMENTARY.equals(type)) {
			campaignName.setMaxLength(60);
		}else {
			campaignName.setMaxLength(CampaignConstants.MAX_CAMPAIGN_NAME_LEN);
		}
		campaignName.setRequired(true);
		campaignName.setAutofocus(true);
		
		RadioElement applicableType = new RadioElement(" ", "applicableType");
		applicableType.setValues(getApplicableTypesByRoles(type));
		applicableType.setClassName(MarketingCssHelper.createCssClass(Arrays.asList("col")));
		applicableType.setRequired(true);
		
		RadioElement campaignType = new RadioElement(" ", "campaignType");
		campaignType.setDefaultValue("null");
		campaignType.setValues(Arrays.asList());
		campaignType.setClassName(MarketingCssHelper.createCssClass(Arrays.asList("col d-flex mb-3")));
		campaignType.setRequired(true);
		
		ElementGroup grp5 = FormHelper.createGroup("grp5", Arrays.asList(applicableType));
		grp5.setLabel("Applicable Type");
		grp5.setLabelClassName("text-secondary small");
		grp5.setClassName("radio-arrow");
		
		ElementGroup grp7 = FormHelper.createGroup("grp7", Arrays.asList(campaignType));
		grp7.setLabelClassName(SMALL_TEXT_SECONDARY);
		grp7.setLabel("Campaign Type");
		
		CheckBoxElement channel = new CheckBoxElement("", "channel");
		channel.setValues(Arrays.asList());
		channel.setClassName(MarketingCssHelper.createCssClass(Arrays.asList("col d-flex")));
		channel.setRequired(true);
		channel.setLabelClassName(TEXT_DARK_LABEL_CLASS_NAME);
		channel.setHidden(true);
		
		ElementGroup grp3 = FormHelper.createGroup("grp3", Arrays.asList(channel));
		grp3.setLabel("Channel");
		grp3.setLabelClassName(SMALL_TEXT_SECONDARY);
		grp3.setClassName("p-2");
		
		ElementGroup grp6 = FormHelper.createGroup("grp6",Arrays.asList(grp5));
		grp6.setGroups(Arrays.asList(grp5));
		grp6.setClassName("border-bottom p-2");
		
		InputElement minInvoiceValue = new InputElement(InputType.TEXT, "Min Invoice Value", "minInvoiceValue");
		minInvoiceValue.setClassName(MarketingCssHelper.createCssClass(Arrays.asList(COL_3_CLASS_NAME)));
		minInvoiceValue.setMin("1");
		minInvoiceValue.setMax("99999");
		minInvoiceValue.setRegex(DOUBLE_REGEX);
		minInvoiceValue.setRequired(true);
		
		ElementGroup minInvoiceValueGrp = FormHelper.createGroup("minInvoiceValueGrp", Arrays.asList(minInvoiceValue));
		minInvoiceValueGrp.setClassName("mt-0 col-3 p-1 mb-2");
		minInvoiceValueGrp.setHidden(true);
		
		ElementGroup grp9 = FormHelper.createGroup("grp9", Arrays.asList(grp7, minInvoiceValueGrp));
		grp9.setGroups(Arrays.asList(grp7, minInvoiceValueGrp));
		grp9.setClassName(CssConstants.ROW_G_3 + " m-0");
		
		ElementGroup grp11 = FormHelper.createGroup("grp11", Arrays.asList(grp3));
		grp11.setGroups(Arrays.asList(grp3));
	
		ElementGroup grp1 = FormHelper.createGroup("grp1", Arrays.asList(campaignName));
		grp1.setClassName("g-3 row col-3 p-1 flex-nowrap mb-3");
		
		RadioElement slabPrice=new RadioElement(" ", "priceConsideredForSlab");
		Option mrpPrice = FormHelper.createOption("MRP Price", "mrpPrice", "M", "mrpPrice");
		Option salePrice = FormHelper.createOption("Sale Price", "S", "salePrice", true);
		slabPrice.setValues(Arrays.asList(salePrice, mrpPrice));
		slabPrice.setClassName(MarketingCssHelper.createCssClass(Arrays.asList("col-12 d-flex mb-3")));
		
		RadioElement status  = new RadioElement("Status: ", "status");
		Option active = FormHelper.createOption(ACTIVE, ACTIVE, "A", "active");
		Option inActive = FormHelper.createOption(INACTIVE, INACTIVE, "I", "inActive");
		status.setValues(Arrays.asList(active, inActive));
		status.setClassName(MarketingCssHelper.createCssClass(Arrays.asList("col d-flex mb-5")));
		status.setRequired(true);
		status.setLabelClassName(TEXT_DARK_LABEL_CLASS_NAME);
		
		grp3.setHidden(true);
		grp7.setHidden(true);
		
		InputElement maxDaysLimit = new InputElement(InputType.NUMBER, "maxDaysLimit", "maxDaysLimit");
		InputElement isToDateMandatory = new InputElement(InputType.NUMBER, "isToDateMandatory", "isToDateMandatory");
		maxDaysLimit.setHidden(true);
		isToDateMandatory.setHidden(true);
		isToDateMandatory.setValue("1");
		if(MULTIITEM.equalsIgnoreCase(type)) {
			maxDaysLimit.setValue(toDateMaxLimit);
		} else if(REGULAR.equalsIgnoreCase(type)) {
			maxDaysLimit.setValue("");
			isToDateMandatory.setValue("0");
		} else if(CAMPAIGN.equalsIgnoreCase(type)) {
			maxDaysLimit.setValue(toDateMaxLimitForCampaign);
		} else if(COMPLIMENTARY.equalsIgnoreCase(type)) {
			maxDaysLimit.setValue(toDateMaxLimitForComplimentary);
		}
		CheckBoxElement allCustomers = new CheckBoxElement(" All Customers ", "allCustomers");
		allCustomers.setSwitchType(true);
		Option yes = FormHelper.createOption("YES", "Y", "Y", true);
		allCustomers.setValues(Arrays.asList(yes));
		
		ElementGroup grp10 =  FormHelper.createGroup("grp10", Arrays.asList(allCustomers, maxDaysLimit, isToDateMandatory));
		grp10.setClassName(MarketingCssHelper.createCssClass(Arrays.asList("col-4 mt-2 mb-2")));

		ElementGroup grp4 = FormHelper.createGroup("grp4", Arrays.asList(slabPrice));
		grp4.setLabel("Price Considered for slab");
		grp4.setLabelClassName(SMALL_TEXT_SECONDARY);
		grp4.setClassName("g-3 col-3 flex-nowrap column-gap-3");

		ElementGroup grp8 = FormHelper.createGroup("grp8", Arrays.asList(grp4, grp10));
		grp8.setGroups(Arrays.asList(grp4,grp10));
		grp8.setClassName("row g-3 align-items-center m-0");
		
		campaignInfo.setHtmlGroups(Arrays.asList(grp1, grp6, grp9, grp11, grp8));
		DomManipulation domAction = FormHelper.createDomManipulationAction(DomType.FORM, campaignInfo, ElementPosition.UPDATE, "INIT");
		
		return new Response(domAction, StatusCode.SUCCESS, SUCCESS);
	}
	
	@GetMapping("get-meta-info-form")
	public Response metaInfoForm(HttpServletRequest request, HttpServletResponse response) {
		Form metaInfo = new Form("", "metaInfo");
		
		TextAreaElement longDescription=new TextAreaElement("Campaign Description","longDescription");
		longDescription.setClassName(MarketingCssHelper.createCssClass(Arrays.asList(CssConstants.COL_6)));
		longDescription.setRows(4);
		longDescription.setCols(50);
	    longDescription.setRequired(true);
	    longDescription.setHelperText("0 / 4000");
	            
		CheckBoxElement promotionVisible=new CheckBoxElement("", "promotionVisible");
		promotionVisible.setClassName("mt-3");
		Option promotionOpt=FormHelper.createOption("Promotion Visible",PROMOTION, PROMOTION, PROMOTION);
		promotionVisible.setValues(Arrays.asList(promotionOpt));
		promotionVisible.setClassName(COL_COL_3_CLASS_NAME);
		promotionVisible.setHidden(true);
		
		CheckBoxElement claimable=new CheckBoxElement("", CLAIMABLE);
		claimable.setClassName("mt-3");
		Option claimableOpt=FormHelper.createOption("Claimable",CLAIMABLE, CLAIMABLE, CLAIMABLE);
		claimable.setValues(Arrays.asList(claimableOpt));
		claimable.setClassName(COL_COL_3_CLASS_NAME);
		
		CheckBoxElement specialityBased=new CheckBoxElement("", SPECIALITY_BASED);
		specialityBased.setClassName("mt-3");
		Option specialityOpt=FormHelper.createOption("Speciality Based",SPECIALITY_BASED, SPECIALITY_BASED, SPECIALITY_BASED);
		specialityBased.setValues(Arrays.asList(specialityOpt));
		specialityBased.setClassName(COL_COL_3_CLASS_NAME);
		specialityBased.setHidden(true);

		ElementGroup group2 = FormHelper.createGroup("group2", Arrays.asList(promotionVisible,claimable, specialityBased));
		group2.setClassName(CssConstants.ROW_G_3 + CssConstants.MB_3 + " mx-0");
		
		ElementGroup group1 = FormHelper.createGroup("group1", Arrays.asList( longDescription));
		group1.setClassName("align-helpertext-right row g-0");
		metaInfo.setHtmlGroups(Arrays.asList(group1,group2));
		DomManipulation domAction = FormHelper.createDomManipulationAction(DomType.FORM, metaInfo, ElementPosition.UPDATE, "INIT");
		
		return new Response(domAction, StatusCode.SUCCESS, SUCCESS);
	}
	
	@GetMapping("get-loyalty-types")
	public Response loyaltyTypes(HttpServletRequest request, HttpServletResponse response) {
		Map<Integer,String> loyaltyTypes = multiItemCampaignService.getLoyaltyTypes();
		if(UtilValidate.isNotEmpty(loyaltyTypes))
			return new Response(StatusCode.SUCCESS, SUCCESS, loyaltyTypes);
		else
			return new Response(StatusCode.FAILURE, FAILURE_MESSAGE);

	}
	
	@GetMapping("/get-image-server-details")
	public ImageServer getImageServerDetails(HttpServletRequest request, @RequestParam String imageType){
		return imageServerHepler.getImageServerDetails(request.getSession().getId(), imageType);
	}
	
	@GetMapping("get-regions-form")
	public Response getRegionsForm(@RequestParam(defaultValue = "false", required = false) boolean isMultipleCampaigns) {
		Form regionsForm = new Form("", "regionsForm");

		RadioElement regionType = new RadioElement(" ", "regionType");
		regionType.setClassName(MarketingCssHelper.createCssClass(Arrays.asList("col d-flex border-bottom pb-2")));
		regionType.setName("region");
		
		ElementGroup regionTypeGrp = FormHelper.createGroup("regionTypeGrp", Arrays.asList(regionType));
		regionTypeGrp.setClassName(COL_4 + " mb-2 radio-arrow");
		regionTypeGrp.setLabelClassName(SMALL_TEXT_SECONDARY);
		regionTypeGrp.setLabel("Region Type");

		CheckBoxElement isMultCampaigns=new CheckBoxElement("", "isMultipleCampaigns");
		ElementGroup isMultipleCampaignsGrp = FormHelper.createGroup("isMultipleCampaignsGrp", Arrays.asList(isMultCampaigns));
		ElementGroup regionGrp = FormHelper.createGroup("regionGrp", Arrays.asList());
		if(isMultipleCampaigns) {
			isMultCampaigns.setClassName("mt-3");
			Option opt=FormHelper.createOption("Multiple Campaigns","true", "true", "true");
			isMultCampaigns.setValues(Arrays.asList(opt));
			isMultCampaigns.setDisabled(true);
			isMultCampaigns.setHidden(true);
		
			isMultipleCampaignsGrp.setClassName(COL_COL_3_CLASS_NAME + " m-2");
			regionGrp.setGroups(Arrays.asList(regionTypeGrp, isMultipleCampaignsGrp));
		} else {
			regionGrp.setGroups(Arrays.asList(regionTypeGrp));
		}
		regionGrp.setClassName("row");
		
		RadioElement country = new RadioElement("  ", "country");
		country.setRequired(true);
		country.setClassName("col");
		country.setName("country");
		
		ElementGroup grp4 = FormHelper.createGroup("grp4", Arrays.asList(country));
		grp4.setLabelClassName(SMALL_TEXT_SECONDARY);
		grp4.setLabel("Country");
		grp4.setHidden(true);
		
		DataListElement state = new DataListElement("state");
		state.setLabel("State");
		state.setLabelClassName(SMALL_TEXT_SECONDARY+" w-100");
		state.setRequired(true);
		state.setHidden(true);
		state.setDataListClassName(CssConstants.COL_3);

		DataListElement city = new DataListElement("city");
		city.setLabel("City");
		city.setDataListClassName(CssConstants.COL_3);
		city.setRequired(true);
		city.setLabelClassName(W_100);
		city.setHidden(true);
		
		DataListElement store = new DataListElement("store");
		store.setLabel("Store");
		store.setDataListClassName(CssConstants.COL_3);
		store.setRequired(true);
		store.setLabelClassName(W_100);
		store.setHidden(true);
		
		InputElement notEligibleRegions = new InputElement(InputType.TEXT, "Not Eligible Regions", "notEligibleRegions");
		notEligibleRegions.setHidden(true);
		notEligibleRegions.setMaxLength(6534);
		notEligibleRegions.setLabelClassName(CssConstants.COL_3);
		
		ButtonElement addRegion = new ButtonElement("Add", "addRegion");
		addRegion.setClassName("btn rounded-2 shadow-sm p-12 btn-success px-5");
		addRegion.setHidden(true);
		
		Map<String, String> attributes = new HashMap<>();
		attributes.put("height", "50px");
		addRegion.setAttributes(attributes);
		
		ElementGroup grp8 = FormHelper.createGroup("grp8", Arrays.asList(addRegion));
		grp8.setClassName("col mt-auto");
		

		ElementGroup grp2 = FormHelper.createGroup("grp2", Arrays.asList(state,city, store,notEligibleRegions));
		grp2.setClassName(" row flex-wrap g-3 mt-0 mb-3");

		InputElement storeRegions = new InputElement(InputType.TEXT, "Store IDs", "storeIds");
		storeRegions.setLabelClassName("position-relative col-4 w-100");
		
		          
		ElementGroup grp9 = FormHelper.createGroup("grp9", Arrays.asList(storeRegions));
		grp9.setLabelClassName(SMALL_TEXT_SECONDARY);
		grp9.setLabelClassName("mb-1");
		grp9.setClassName(COL_4);
		grp9.setHidden(true);
		
		ElementGroup grp6 = FormHelper.createGroup("grp6", Arrays.asList());
		grp6.setGroups(Arrays.asList(regionGrp, grp4, grp2, grp9, grp8));
		grp6.setLabel("Select Region");
		grp6.setLabelClassName(CUSTOM_FIELD_SET + " mb-2");
		grp6.setClassName("row");
		
		
		regionsForm.setHtmlGroups(Arrays.asList(grp6));

		DomManipulation domAction= FormHelper.createDomManipulationAction(DomType.FORM, regionsForm, ElementPosition.UPDATE, "INIT");
		return new Response(domAction, StatusCode.SUCCESS, SUCCESS);
	}
	
	@GetMapping("get-multiitem-slab-form") 
	public Response getMultiItemSlabForm() {
		Form slabForm = new Form("", "multiItemCampaignSlab");
		slabForm.setClassName(" row align-items-center justify-content-start mb-3 rounded");
		InputElement numOfUnitsInput = new InputElement(InputType.TEXT, "Number Of Packs", "numberOfPacks");
		numOfUnitsInput.setClassName("form-control");
		numOfUnitsInput.setMaxLength(9);
		numOfUnitsInput.setRegex(NUMBER_REGEX);
		numOfUnitsInput.setAutofocus(true);
		numOfUnitsInput.setRequired(true);
		
		ElementGroup numOfUnitsGroup = FormHelper.createGroup("numberOfUnitsGroup", Arrays.asList(numOfUnitsInput));
		numOfUnitsGroup.setClassName("col col-md-4");
		
		InputElement priceOrNumOfUnitsForPrice = new InputElement(InputType.TEXT, "Total Price (or) Payable Packs", "sellingPriceOrNumberOfPacks");
		priceOrNumOfUnitsForPrice.setRegex(DOUBLE_REGEX);
		priceOrNumOfUnitsForPrice.setClassName("form-control");
		priceOrNumOfUnitsForPrice.setRequired(true);
		
		
		ElementGroup priceOrNumOfUnitsForPriceGroup = FormHelper.createGroup("priceOrNumOfUnitsForPriceGroup", Arrays.asList(priceOrNumOfUnitsForPrice));
		priceOrNumOfUnitsForPriceGroup.setClassName("col col-md-4");

		ButtonElement addSlabBtn = new ButtonElement("Add", "addNewSlab");
		addSlabBtn.setClassName("btn btn-success shadow-sm p-12  rounded col-3");

		ElementGroup addSlabBtnGroup = FormHelper.createGroup("addSlabBtnGroup", Arrays.asList(addSlabBtn));
		addSlabBtnGroup.setClassName("col col-md-3");
		
		
		ElementGroup grp1 = FormHelper.createGroup("grp1", Arrays.asList());
		grp1.setGroups(Arrays.asList(numOfUnitsGroup, priceOrNumOfUnitsForPriceGroup, addSlabBtnGroup));
		grp1.setLabel("Create Slab");
		grp1.setLabelClassName(CUSTOM_FIELD_SET + " mb-2");
		grp1.setClassName("row");
		
		
		slabForm.setHtmlGroups(Arrays.asList(grp1));
		DomManipulation domAction = FormHelper.createDomManipulationAction(DomType.FORM, slabForm, ElementPosition.UPDATE, "INIT");
		return new Response(domAction, StatusCode.SUCCESS, SUCCESS);
	}

	@GetMapping("get-countries")
	public Response getAllCountries() throws PartnerException {
		
		Map<String,String> countriesMap=regionService.getAllCountries();
		log.debug("CountriesMap: {}" , countriesMap);
		if(UtilValidate.isEmpty(countriesMap)) 
			return new Response(StatusCode.SUCCESS,NO_DATA_FOUND, Collections.emptyMap());
		countriesMap = countriesMap.entrySet().stream()
					        .collect(Collectors.toMap(
					                entry -> WordUtils.capitalizeFully(entry.getKey()),
					                Map.Entry::getValue
					        ));

		return new Response(StatusCode.SUCCESS, SUCCESS_MESSAGE,countriesMap);

	}
	
	@GetMapping("get-states")
	public Response getStatesForCountryCode(@RequestParam("countrycode") String countryCode) throws PartnerException{	
		
		Map<String,String> statesMap=regionService.getStates(countryCode);
		log.debug("States for country: {}, {}", countryCode, statesMap);
		if(UtilValidate.isEmpty(statesMap)) 
			return new Response(StatusCode.SUCCESS,NO_DATA_FOUND, Collections.emptyMap());
		statesMap = statesMap.entrySet().stream()
		        .collect(Collectors.toMap(
		                entry -> WordUtils.capitalizeFully(entry.getKey()),
		                Map.Entry::getValue
		        ));
		
		return new Response(StatusCode.SUCCESS, SUCCESS_MESSAGE,statesMap);

	}
	
	@GetMapping("get-cities")
	public Response getCitiesForState(@RequestParam("statecode") String stateCode) throws PartnerException {
		
		Map<String,String> citiesForStateMap=regionService.getCitiesForState(stateCode);
		log.debug("Cities for State: {}, {}", stateCode, citiesForStateMap);
		if(UtilValidate.isNotEmpty(citiesForStateMap)) {
			citiesForStateMap = citiesForStateMap.entrySet().stream()
					.collect(Collectors.toMap(
							entry -> WordUtils.capitalizeFully(entry.getKey()),
							Map.Entry::getValue
							));
			return new Response(StatusCode.SUCCESS, SUCCESS_MESSAGE,citiesForStateMap);
		}
		return new Response(StatusCode.SUCCESS, NO_DATA_FOUND,Collections.emptyMap());

	}

	@GetMapping("get-stores")
	public Response getStores(@RequestParam("citycode") String cityCode) {
		StoreSearchCriteria criteria = new StoreSearchCriteria();
		criteria.setCityCodeList(Arrays.asList(cityCode));
