	@PostMapping("get-store-names")
	public Response getStoreNames(@RequestBody List<String> storeIds,@RequestParam(value = "applicableType", required = false) Integer applicableType) {
		StoreSearchCriteria criteria = new StoreSearchCriteria();
		criteria.setStoreIds(storeIds);
		return getActiveStoresInfo(criteria, Objects.equals(PromotionConstants.APPLICABLE_TYPE_PATHLABS, applicableType));
	}
	
	private Response getActiveStoresInfo(StoreSearchCriteria criteria, boolean isPathLabs) {
		try {
			List<StoreDetails> stores = productStoreHelper.getStoreDetails(criteria, isPathLabs, UserUtil.getUserDetails());
			if (UtilValidate.isNotEmpty(stores)) {
				return new Response(StatusCode.SUCCESS, SUCCESS_MESSAGE, ProductStoreHelper.getStoresInfo(stores));
			}
		} catch (Exception e) {
			log.error(e.getMessage(), e);
		}
		return new Response(StatusCode.SUCCESS, NO_DATA_FOUND, Collections.emptyMap());
	}
	
	@PreAuthorize(MarketingConstants.MIC_CREATE_RIGHTS)
	@PostMapping("create-multi-item-campaign")
	public Response createMultiItemCampaign(@RequestParam("campaignInfo") String multiItemCampaignInfo, @RequestParam(value = "productUpload", required = true) MultipartFile productUpload, @RequestParam(value = "productRemove", required = false) MultipartFile productRemove, @RequestParam(value = "customerUpload", required = false) MultipartFile customerUpload, @RequestParam(value = "customerRemove", required = false) MultipartFile customerRemove) {
		
		log.debug("MultiItemCampaign for Creation:{}",multiItemCampaignInfo);
		
		MultiItemCampaignMaster campaign = GSON.fromJson(multiItemCampaignInfo, new TypeToken<MultiItemCampaignMaster>() {}.getType());
		List<Integer> applicableTypesByRole =MIC_ROLES.getApplicableTypesByCreateRoles(); 
		if(campaign == null) 
			throw new MarketingException("Campaign data is empty");
		if(!applicableTypesByRole.contains(campaign.getApplicableType()))
			throw new MarketingException("User doesn't have the required Applicable Rights to create campaign!");
		Set<String> productItems=ExcelUtil.readUploadExcel(productUpload, String.class, campaign.getApplicableType(), false);
		campaign.setItems(productItems);
		validateProductItems(productItems, campaign.getApplicableType(), true);
		if(!campaign.isAllCustomers()) {
			Set<Long> customerIds=ExcelUtil.readUploadExcel(customerUpload, Long.class, campaign.getApplicableType(), true);
			campaign.setCustomerIds(customerIds);
		}
		if(campaign.getUserMetaData() != null) {
			campaign.getUserMetaData().setCreatedBy(UserUtil.getUserId());
			campaign.getUserMetaData().setDateCreated(LocalDateTime.now());
		}else {
			throw new MarketingException("Meta Info is Empty");
		}
		log.debug("MultiItemCampaign before Creation: {}", campaign);
		MultiItemCampaign createdCampaign=multiItemCampaignService.createMultiItemCampaign(campaign);
		log.info("MultiItemCampaign Created : {}, Status:{}", createdCampaign.getCampaignId(), createdCampaign.getStatus());
		return new Response(StatusCode.SUCCESS, SUCCESS, createdCampaign);
	}
	
	private void validateProductItems(Set<String> productItems, int applicableType, boolean isCreate) {
		if(isCreate && (UtilValidate.isEmpty(productItems) || productItems.size() == 1)) {
			throw new MarketingException("At least 2 product ids are required to configure a multi-item campaign");
		}		
		if(applicableType == PromotionConstants.APPLICABLE_TYPE_PATHLABS) {
			CampaignUtil.validateIds(productItems, CampaignUtil.getPathLabTestMap(new ArrayList<>(productItems), pathLabTestsService, false, true).keySet(), "Path Lab Tests");
		} else {
			CampaignUtil.validateIds(productItems, CampaignUtil.getProductMap(productItems,"items",productService, true).keySet(),"Items");
		}
	}

	@PreAuthorize(MarketingConstants.MIC_VIEW_RIGHTS)
	@PostMapping("get-multiItem-campaign")
	public Response listMultiItemCampaigns(@RequestParam("campaignSearchCriteria") String campaignInfo) {
		CampaignSearchCriteria searchCriteria = GSON.fromJson(campaignInfo, new TypeToken<CampaignSearchCriteria>() {}.getType());
		log.debug("CampaignSearchCriteria: {}",searchCriteria);
		List<Integer> applicableTypesByRole =MIC_ROLES.getApplicableTypesByViewRoles();
		Map<String, Object> response = multiItemCampaignService.getMultiItemCampaignList(searchCriteria, applicableTypesByRole);
		if(UtilValidate.isNotEmpty(response))
			return new Response(StatusCode.SUCCESS, SUCCESS, response);
		return new Response(StatusCode.SUCCESS, NO_DATA_FOUND, Collections.emptyMap());
	}
	
	private List<Option> getUsers(String type) {
		List<String> createRoles = new ArrayList<>();
		if(MULTIITEM.equalsIgnoreCase(type)) {
			createRoles = MIC_ROLES.getCreatedByRoles();
		} else if(REGULAR.equalsIgnoreCase(type)) {
			createRoles = RP_ROLES.getCreatedByRoles();
		} else if(CAMPAIGN.equalsIgnoreCase(type)) {
			createRoles = CAMPAIGN_ROLES.getCreatedByRoles();
		} else if(COMPLIMENTARY.equalsIgnoreCase(type)) {
			createRoles = COMPLIMENTARY_ROLES.getCreatedByRoles();
		}	
		try {
			UserSearchCriteria searchCriteria = new UserSearchCriteria();
			searchCriteria.setTenantId(UserUtil.getTenantId());
			searchCriteria.setRoleNames(createRoles);
			searchCriteria.setModuleName(MarketingConstants.MODULE_NAME);
			List<UserDetails> userDetailsList = userService.getUserDetails(searchCriteria);
			log.debug("Users with MultiItemCampaign Creation Roles: {} are {}",createRoles, userDetailsList);
			List<Option> responseData = new ArrayList<>();
			userDetailsList.forEach(user -> {
				String displayValue = user.getName()+" ("+user.getUserId()+")";
				Option option = FormHelper.createOption(displayValue, user.getName(), user.getUserId(), user.getUserId());
				responseData.add(option);
			});
			return responseData;
		} catch (UMSException e) {
			log.error("Error fetching users : {}", e);
			return new ArrayList<>();
		}
	}
	
	private static List<Option> getPromotionLevels() {
		List<Option> promotionLevels = new ArrayList<>();
		promotionLevels.add(FormHelper.createOption("Invoice", INVOICE, "I", INVOICE));
		promotionLevels.add(FormHelper.createOption("Category", CATEGORY, "C" , CATEGORY));
		return promotionLevels;
	}
	
