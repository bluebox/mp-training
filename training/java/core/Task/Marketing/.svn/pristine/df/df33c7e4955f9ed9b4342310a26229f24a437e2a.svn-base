	@PreAuthorize(MarketingConstants.MIC_VIEW_RIGHTS)
	@GetMapping("get-multi-item-campaign-by-campaignid")
	public Response getMultiItemCampaignByCampaignId(@RequestParam("campaignId") Integer campaignId) {
		if(UtilValidate.isNotEmpty(campaignId)) {
			MultiItemCampaign campaign = multiItemCampaignService.getMultiItemCampaign(campaignId);
			log.debug("MultiItemCampaignById: {}", campaign);
			if(UtilValidate.isNotEmpty(campaign)) {
				return new Response(StatusCode.SUCCESS, SUCCESS, campaign);
			}
			return new Response(StatusCode.SUCCESS, "No records found");
		}
		return new Response(StatusCode.FAILURE, "Failed to fetch records");
	}
	
	@PreAuthorize(MarketingConstants.MIC_EDIT_RIGHTS)
	@PostMapping("edit-multi-item-campaign")
	public Response editMultiItemCampaign(@RequestParam("campaignInfo") String multiItemCampaignInfo, @RequestParam(value = "productUpload", required = false) MultipartFile productUpload, @RequestParam(value = "productRemove", required = false) MultipartFile productRemove, @RequestParam(value = "customerUpload", required = false) MultipartFile customerUpload, @RequestParam(value = "customerRemove", required = false) MultipartFile customerRemove) {
		log.debug("MultiItemCampaign Edit:{}",multiItemCampaignInfo);
		MultiItemCampaignMaster campaign = GSON.fromJson(multiItemCampaignInfo, new TypeToken<MultiItemCampaignMaster>() {}.getType());
		List<Integer> applicableTypesByRole =MIC_ROLES.getApplicableTypesByEditRoles(); 
		if(campaign == null) 
			throw new MarketingException("Campaign data is null");
		if(!applicableTypesByRole.contains(campaign.getApplicableType()))
			throw new MarketingException("User doesn't have the required Applicable Rights to edit campaign!");
		if(UtilValidate.isNotEmpty(productUpload)) {
			campaign.setItems(ExcelUtil.readUploadExcel(productUpload, String.class, campaign.getApplicableType(), false));
			validateProductItems(campaign.getItems(), campaign.getApplicableType(), false);
		} else {
			campaign.setItems(Collections.emptySet());
		}
		if(UtilValidate.isNotEmpty(productRemove)) {
			campaign.setRemovedItems(ExcelUtil.readUploadExcel(productRemove, String.class, campaign.getApplicableType(), false));
		} else {
			campaign.setRemovedItems(Collections.emptySet());
		}
		if(!campaign.isAllCustomers()) {
			if(UtilValidate.isNotEmpty(customerUpload)) {
				campaign.setCustomerIds(ExcelUtil.readUploadExcel(customerUpload, Long.class, campaign.getApplicableType(), true));
			} else {
				campaign.setCustomerIds(Collections.emptySet());
			}
			if(UtilValidate.isNotEmpty(customerRemove)) {
				campaign.setRemovedCustomerIds(ExcelUtil.readUploadExcel(customerRemove, Long.class, campaign.getApplicableType(), true));
			} else {
				campaign.setRemovedCustomerIds(Collections.emptySet());
			}
		}
		if(UtilValidate.isEmpty(campaign.getUserMetaData())) {
			throw new MarketingException("MetaInfo is required");
		}
		campaign.getUserMetaData().setModifiedBy(UserUtil.getUserId());
		campaign.getUserMetaData().setDateModified(LocalDateTime.now());
		log.debug("MultiItemCampaign before Edit: {}", campaign);
		MultiItemCampaign multiItemCampaign = multiItemCampaignService.updateMultiItemCampaign(campaign);
		log.info("MultiItemCampaign Updated : {}, Status:{}", multiItemCampaign.getCampaignId(), multiItemCampaign.getStatus());
		log.debug("Updated MultiItemCampaign: {}", multiItemCampaign);
		if(UtilValidate.isNotEmpty(multiItemCampaign)) {
			return new Response(StatusCode.SUCCESS, SUCCESS, multiItemCampaign);
		}
		return new Response(StatusCode.FAILURE, UNABLE_TO_UPDATE);
	}
	
	@PreAuthorize(MarketingConstants.MIC_APPROVE_RIGHTS)
	@PostMapping("approve-multi-item-campaign")
	public Response approveMultiItemCampaign(@RequestParam("campaignId") Integer campaignId, @RequestParam("toDate") String date, @RequestParam(value = "channel", required = false) Integer channel) {
		log.info("MultiItemCampaign Approve: {}, toDate: {}", campaignId, date);
		LocalDateTime toDate = null;
		try {
			toDate = Instant.ofEpochMilli(Long.parseLong(date)).atZone(ZoneId.systemDefault()).toLocalDateTime();
		} catch (NumberFormatException e) {
			throw new MarketingException(INVALID_TO_DATE);
		}
		List<Integer> applicableTypesByRole = MIC_ROLES.getApplicableTypesByApproveRoles(); 
		boolean approved = multiItemCampaignService.approveCampaign(campaignId, toDate, applicableTypesByRole, UserUtil.getUserId());
		log.info("MultiItemCampaign Approved: {}, Status: {}",campaignId, approved);
		if(approved) {
			if(UtilValidate.isNotEmpty(channel) && channel == Channel.POS.getChannel())
				posMasterDataHelper.pushToMasterDataUpdateInfoQueue(PosMasterDataKey.MULTI_ITEM_PROMOTIONS, campaignId, new Date());
			return new Response(StatusCode.SUCCESS, SUCCESS, campaignId);
		}else {
			return new Response(StatusCode.FAILURE, "Unable to Approve Campaign");
		}
	}
	
	@PreAuthorize(MarketingConstants.MIC_CLOSE_RIGHTS)
	@PostMapping("update-multi-item-campaign-to-date")
	public Response updateActiveMultiItemCampaign(@RequestParam("campaignId") Integer campaignId, @RequestParam("toDate") String date, @RequestParam(value = "channel", required = false) Integer channel) {
		List<Integer> applicableTypesByRole = MIC_ROLES.getApplicableTypesByCloseRoles(); 
		return updateToDate(date, applicableTypesByRole, PromotionConstants.ACTIVE, campaignId, channel);
	}
	
	@PreAuthorize(MarketingConstants.MIC_EDIT_RIGHTS)
	@PostMapping("update-inactive-multi-item-campaign-to-date")
	public Response updateInctiveMultiItemCampaign(@RequestParam("campaignId") Integer campaignId, @RequestParam("toDate") String date) {
		List<Integer> applicableTypesByRole = MIC_ROLES.getApplicableTypesByEditRoles(); 
		return updateToDate(date, applicableTypesByRole, PromotionConstants.INACTIVE, campaignId, null);
	}
	
	private Response updateToDate(String date, List<Integer> applicableTypesByRole, String status, Integer campaignId, Integer channel) {
		log.info("MultiItemCampaign ToDate Update: {}, toDate: {}", campaignId, date);
		LocalDateTime toDate = null;
		try {
			toDate = Instant.ofEpochMilli(Long.parseLong(date)).atZone(ZoneId.systemDefault()).toLocalDateTime();
		} catch (NumberFormatException e) {
			throw new MarketingException(INVALID_TO_DATE);
		}
		boolean updated = multiItemCampaignService.updateActiveCampaignToDate(campaignId, toDate, applicableTypesByRole, UserUtil.getUserId(), status);
		log.info("MultiItemCampaign Updated: {}, Status: {}",campaignId, updated);
		if(updated) {
			if(UtilValidate.isNotEmpty(channel) && channel == Channel.POS.getChannel())
				posMasterDataHelper.pushToMasterDataUpdateInfoQueue(PosMasterDataKey.MULTI_ITEM_PROMOTIONS, campaignId, new Date());
			return new Response(StatusCode.SUCCESS, SUCCESS, campaignId);
		}else {
			return new Response(StatusCode.FAILURE, UNABLE_TO_UPDATE);
		}
	}
	
	@PreAuthorize(MarketingConstants.MIC_VIEW_RIGHTS)
	@GetMapping("get-product-excel-download")
	public ResponseEntity<ByteArrayResource> getProductExcelDownload(@RequestParam("campaignId") Integer campaignId,@RequestParam("applicableType") Integer applicableType) {
		log.debug("MultiItemCampaign Products Download: {}", campaignId);
		Set<String> productData = multiItemCampaignService.getCampaignItems(campaignId);
		HttpHeaders header = new HttpHeaders();
		header.setContentType(new MediaType("application", "force-download"));
		header.set(HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=ProductTemplate.xlsx");
	    if (productData != null) {
	    	log.debug("MultiItemCampaign Products Download Size: {}", productData.size());
			Map<String, String> itemsMap;
			if(applicableType == PromotionConstants.APPLICABLE_TYPE_PATHLABS) {
				itemsMap =CampaignUtil.getPathLabTestMap(new ArrayList<>(productData), pathLabTestsService, false, false);
			} else {
				itemsMap =CampaignUtil.getProductMap(productData, "Items", productService, false);
			}
	    	byte[] excellData = ExcelUtil.writeExcel(productData, "ItemId", itemsMap);
	    	return new ResponseEntity<>(new ByteArrayResource(excellData),
                    header, HttpStatus.OK);
	    }
		return new ResponseEntity<>(new ByteArrayResource(new byte[0]),
                header, HttpStatus.OK);
	}
	
	@PreAuthorize(MarketingConstants.MIC_VIEW_RIGHTS)
	@GetMapping("get-customer-excel-download")
	public ResponseEntity<ByteArrayResource> getCustomerExcelDownload(@RequestParam("campaignId") Integer campaignId) {
		log.debug("MultiItemCampaign Customers Download: {}", campaignId);
		Set<Long> customerData = multiItemCampaignService.getCampaignCustomerIds(campaignId);
		return CampaignUtil.downloadExcel(customerData, "CustomerId", "force-download", "CustomerTemplate.xlsx");	
	}
	
	@PreAuthorize(MarketingConstants.MIC_VIEW_RIGHTS)
	@GetMapping("get-multi-stores-download")
	public ResponseEntity<ByteArrayResource> getStoresExcelDownload(@RequestParam("campaignId") Integer campaignId) {
		log.debug("MultiItemCampaign Stores Download: {}", campaignId);
		List<String> storeIds = multiItemCampaignService.getStores(campaignId);
		return ProductStoreHelper.downloadStoresExcel(storeIds, accountStoreService);
	}
		
	@GetMapping("get-regions-data-grid")
	public Response getRegionsDataGrid(@RequestParam("editableFeild") boolean editable,@RequestParam("isStoreLevel") boolean isStoreLevel) {
		DataGrid grid = MarketingDataGridHelper.prepareRegionsGrid(editable, isStoreLevel);
		if(UtilValidate.isNotEmpty(grid))
			return new Response(StatusCode.SUCCESS, SUCCESS, grid);
		return new Response(StatusCode.FAILURE, "Something Went Worng");
	}
	
	@GetMapping("validate-campaign-name")
	public Response validateCampaignName(@RequestParam("campaignName") String campaignName) {
		boolean isValidCampaignName = multiItemCampaignService.isCampaignNameAvailable(campaignName);
		log.debug("MultiItemCampaign Name: {}, Exists: {}", campaignName, isValidCampaignName);

		return new Response(StatusCode.SUCCESS, SUCCESS, !isValidCampaignName);
	}
	
	@PreAuthorize(MarketingConstants.MIC_APPROVE_RIGHTS)
	@PostMapping("reject-multi-item-campaign")
	public Response rejectCampaign(@RequestParam("campaignId") Integer campaignId, @RequestParam("remarks") String remarks) {
		
		if(UtilValidate.isNotEmpty(campaignId) && UtilValidate.isNotEmpty(remarks)) {
			if(remarks.length()>255 || remarks.trim().length()<=0)
				return new Response(StatusCode.FAILURE, "Remarks length should be between 0 and 255");
			multiItemCampaignService.rejectMultiItemCampaign(campaignId, UserUtil.getUserId(), remarks, MIC_ROLES.getApplicableTypesByApproveRoles());
			return new Response(StatusCode.SUCCESS, SUCCESS);
		}
		return new Response(StatusCode.FAILURE, "Unable to reject the campaign");
	}
	
	@Scheduled(cron = "0 30 0 * * *")
	public void autoRejectClosedCampaigns() {
		try {
			multiItemCampaignService.autoRejectClosedCampaigns();
		} catch (Exception e) {
			log.error("Error occured while running the auto-reject cron : ", e);
		}
	}

}
