<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" alignment="CENTER" xmlns:fx="http://javafx.com/fxml" fx:controller="com.library.controller.MainMenuController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Button text="Add Book" onAction="#handleAddBook"/>
    <Button text="Add Member" onAction="#handleAddMember"/>
    <Button text="Issue Book" onAction="#handleIssueBook"/>
    <Button text="Return Book" onAction="#handleReturnBook"/>
    <Button text="View Books" onAction="#handleViewBooks"/>
    <Button text="View Members" onAction="#handleViewMembers"/>
    <Button text="Return Book" onAction="#handleReturnBook" />


</VBox>
