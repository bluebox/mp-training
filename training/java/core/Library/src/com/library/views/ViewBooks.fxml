<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox fx:controller="com.library.controller.ViewBooksController"
      xmlns:fx="http://javafx.com/fxml"
      spacing="10" alignment="CENTER" prefWidth="600" prefHeight="400"
      xmlns="http://javafx.com/javafx/8.0.171">

    <Label text="All Books" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TableView fx:id="bookTable" prefWidth="580">
        <columns>
            <TableColumn fx:id="idCol" text="Book ID" prefWidth="60"/>
            <TableColumn fx:id="titleCol" text="Title" prefWidth="150"/>
            <TableColumn fx:id="authorCol" text="Author" prefWidth="100"/>
            <TableColumn fx:id="categoryCol" text="Category" prefWidth="100"/>
            <TableColumn fx:id="statusCol" text="Status" prefWidth="60"/>
            <TableColumn fx:id="availabilityCol" text="Availability" prefWidth="80"/>
        </columns>
    </TableView>
</VBox>
