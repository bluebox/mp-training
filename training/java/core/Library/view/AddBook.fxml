<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx/8"
      fx:controller="controller.AddBookController" spacing="10">
     <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Add New Book" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <TextField fx:id="txtTitle" promptText="Title" />
    <TextField fx:id="txtAuthor" promptText="Author" />
    <TextField fx:id="txtCategory" promptText="Category" />

    <ComboBox fx:id="cbStatus">
    
    </ComboBox>

    <ComboBox fx:id="cbAvailability">
        

    </ComboBox>


    <Button text="Save" onAction="#handleSave" />
</VBox>



