<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx/8"
      fx:controller="controller.IssueBookController" spacing="10">
     <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Issue Book:" />
    <TextField fx:id="txtBookId" promptText="Book ID" />
    <TextField fx:id="txtMemberId" promptText="Member ID" />
    <Button text="Issue Book" onAction="#handleConfirmIssue"/>
</VBox>
