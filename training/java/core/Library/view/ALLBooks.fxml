<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" prefWidth="600" prefHeight="400">
    <children>
        <TableView fx:id="booksTable" layoutX="20" layoutY="20" prefWidth="560" prefHeight="320">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="titleColumn" text="Title" prefWidth="200"/>
                <TableColumn fx:id="authorColumn" text="Author" prefWidth="150"/>
                <TableColumn fx:id="catColumn" text="Category" prefWidth="80"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="80"/>
                <TableColumn fx:id="avilColumn" text="Availability" prefWidth="80"/>

            </columns>
        </TableView>
        <Button fx:id="printButton" text="Print" layoutX="500" layoutY="350" prefWidth="80"/>
    </children>
</AnchorPane>