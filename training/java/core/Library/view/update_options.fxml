<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx/8"
      fx:controller="controller.UpdateOptionsController" spacing="10">
     <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <Label text="Choose Update Option:" />
    <Button text="Update Book Details" onAction="#handleUpdateDetails"/>
    <Button text="Update Availability" onAction="#handleUpdateAvailability"/>
    <Button text="Delete" onAction="#handleDelete"/>


</VBox>
