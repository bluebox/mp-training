<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>


<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.library.controller.EditBookController"
            prefWidth="400" prefHeight="300">
    
    <children>
        <VBox alignment="CENTER" spacing="15" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">
            <Label text="Edit Book Details" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

            <TextField fx:id="titleField" promptText="Title" />
            <TextField fx:id="authorField" promptText="Author" />
            <TextField fx:id="categoryField" promptText="Category" />

            <HBox spacing="10">
                <Label text="Status:" />
                <ChoiceBox fx:id="statusChoice">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="A" />
                            <String fx:value="I" />
                        </FXCollections>
                    </items>
                </ChoiceBox>
            </HBox>

            <HBox alignment="CENTER" spacing="15">
                <Button text="Update" onAction="#handleUpdate" />
                <Button text="Cancel" onAction="#handleCancel" />
            </HBox>
        </VBox>
    </children>

</AnchorPane>
