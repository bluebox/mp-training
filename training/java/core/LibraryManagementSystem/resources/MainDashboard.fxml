<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.controller.MainDashboardController">

    <Label styleClass="heading" text="LIBRARY MANAGEMENT SYSTEM." />

    <HBox alignment="CENTER" spacing="15" styleClass="group-box">
        <Button onAction="#handleAddBook" styleClass="main-button" text="Add Book" />
        <Button onAction="#handleViewBooks" styleClass="main-button" text="View Books" />
    </HBox>

    <HBox alignment="CENTER" prefHeight="71.0" prefWidth="58.0" spacing="15" styleClass="group-box">
        <Button onAction="#handleAddMember" styleClass="main-button" text="Add Member" />
        <Button onAction="#handleViewMembers" styleClass="main-button" text="View Members" />
    </HBox>

    <HBox alignment="CENTER" spacing="15" styleClass="group-box">
        <Button onAction="#handleIssueBook" styleClass="main-button" text="Issue Book" />
        <Button onAction="#handleReturnBook" styleClass="main-button" text="Return Book" />
    </HBox>

    <HBox alignment="CENTER" spacing="15" styleClass="group-box">
        <Button onAction="#handleReports" styleClass="main-button" text="Reports" />
    </HBox>

    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>

</VBox>
