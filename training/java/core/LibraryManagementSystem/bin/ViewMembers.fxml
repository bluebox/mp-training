<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.library.controller.ViewMembersController"
            prefWidth="800" prefHeight="500"
            stylesheets="@viewMembers.css">

    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">
        
            <!-- BACK BUTTON ADDED HERE -->
            <Button text="← Back to Dashboard"
                    onAction="#handleBack"
                    style="-fx-font-size: 14px; -fx-padding: 6;" />

            <Label text="All Members" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            
            <TableView fx:id="memberTable" prefHeight="400">
                <columns>
                    <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="nameCol" text="Name" prefWidth="150"/>
                    <TableColumn fx:id="emailCol" text="Email" prefWidth="200"/>
                    <TableColumn fx:id="mobileCol" text="Mobile" prefWidth="100"/>
                    <TableColumn fx:id="genderCol" text="Gender" prefWidth="80"/>
                    <TableColumn fx:id="addressCol" text="Address" prefWidth="150"/>
                    <TableColumn fx:id="actionCol" text="Action" prefWidth="70"/>
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>
