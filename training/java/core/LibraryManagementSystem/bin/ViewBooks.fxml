<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane prefHeight="600" prefWidth="900"
            stylesheets="@viewBooks.css"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.library.controller.ViewBooksControllers">

    <top>
        <Button text="← Back to Dashboard"
                onAction="#handleBack"
                style="-fx-font-size: 14px; -fx-padding: 10 0 10 10;" />
    </top>

    <center>
        <TableView fx:id="bookTable" prefHeight="500" prefWidth="850">
            <columns>
                <TableColumn fx:id="colId" prefWidth="70" text="BookId" />
                <TableColumn fx:id="colTitle" prefWidth="150" text="Title" />
                <TableColumn fx:id="colAuthor" prefWidth="150" text="Author" />
                <TableColumn fx:id="colCategory" prefWidth="100" text="Category" />
                <TableColumn fx:id="colStatus" prefWidth="80" text="Status" />
                <TableColumn fx:id="colAvailability" prefWidth="100" text="Availability" />
                <TableColumn fx:id="colActions" prefWidth="200" text="Actions" />
            </columns>
        </TableView>
    </center>

    <padding>
        <Insets top="10" right="20" bottom="20" left="20" />
    </padding>

</BorderPane>
