<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<AnchorPane xmlns="http://javafx.com/javafx/24.0.1"
	xmlns:fx="http://javafx.com/fxml/1"
	stylesheets="@../../application/css/updateMember.css"
	fx:controller="com.LibraryManagement.controller.UpdateMemberController"
	prefWidth="400.0" prefHeight="320.0" styleClass="root"
	style="-fx-padding: 15;">

	<VBox spacing="8" layoutX="20.0" layoutY="20.0">
		<Label text="Update Member Details"
			style="-fx-font-size: 14px; -fx-font-weight: bold;" />

		<HBox spacing="6">
			<Label text="Member ID:" minWidth="70" />
			<TextField fx:id="memberIdField"
				promptText="Auto-filled ID" editable="false" prefWidth="150" />
		</HBox>

		<HBox spacing="6">
			<Label text="Name:" minWidth="70" />
			<VBox spacing="2">
				<TextField fx:id="nameField" promptText="Enter full name"
					prefWidth="150" />
				<Label fx:id="nameErrorLabel" text=""
					style="-fx-text-fill: red;" />
			</VBox>
		</HBox>

		<HBox spacing="6">
			<Label text="Email:" minWidth="70" />
			<VBox spacing="2">
				<TextField fx:id="emailField" promptText="Enter email"
					prefWidth="150" />
				<Label fx:id="emailErrorLabel" text=""
					style="-fx-text-fill: red;" />
			</VBox>
		</HBox>

		<HBox spacing="6">
			<Label text="Mobile:" minWidth="70" />
			<VBox spacing="2">
				<TextField fx:id="mobileField"
					promptText="Enter mobile number" prefWidth="150" />
				<Label fx:id="mobileErrorLabel" text=""
					style="-fx-text-fill: red;" />
			</VBox>
		</HBox>

		<HBox spacing="6">
			<Label text="Gender:" minWidth="70" />
			<VBox spacing="2">
				<ComboBox fx:id="genderCombo" promptText="Select gender"
					prefWidth="150">
					<items>
						<FXCollections fx:factory="observableArrayList">
							<String fx:value="Male" />
							<String fx:value="Female" />
						</FXCollections>
					</items>
				</ComboBox>
				<Label fx:id="genderErrorLabel" text=""
					style="-fx-text-fill: red;" />
			</VBox>
		</HBox>

		<HBox spacing="6">
			<Label text="Address:" minWidth="70" />
			<VBox spacing="2">
				<TextArea fx:id="addressArea" promptText="Enter address"
					prefWidth="150" prefRowCount="2" wrapText="true" />
				<Label fx:id="addressErrorLabel" text=""
					style="-fx-text-fill: red;" />
			</VBox>
		</HBox>

		<HBox spacing="10" alignment="CENTER_LEFT">
			<Button fx:id="updateButton" text="Update"
				styleClass="book-button" onAction="#handleUpdate" />
			<Button text="Back" onAction="#Back" styleClass="book-buttons"
				textFill="RED" />
		</HBox>
	</VBox>
</AnchorPane>