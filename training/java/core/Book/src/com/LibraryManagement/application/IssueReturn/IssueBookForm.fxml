<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.text.Font?>
<?import javafx.collections.FXCollections?>

<AnchorPane prefWidth="800.0" prefHeight="550.0"
	xmlns="http://javafx.com/javafx/24.0.1"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.LibraryManagement.controller.IssueBookController"
	stylesheets="@../../application/css/issueBook.css"
	styleClass="member-form">

	<children>
		<VBox spacing="15" alignment="CENTER" prefWidth="400"
			layoutX="200" layoutY="50">

			<Label text="Issue Book" styleClass="form-title">
				<font>
					<Font name="Arial Bold" size="22.0" />
				</font>
			</Label>

			<VBox spacing="3">
				<HBox spacing="10" alignment="CENTER_LEFT">
					<Label text="Book ID:" minWidth="80"
						style="-fx-text-fill: #333333; -fx-font-size: 16px;" />
					<ComboBox fx:id="bookIdComboBox"
						promptText="Select Book ID" prefWidth="220" />
				</HBox>
				<Label fx:id="bookIdError" style="-fx-font-size: 10;"
					textFill="red">
					<padding>
						<Insets top="0" right="0" bottom="0" left="90" />
					</padding>
				</Label>
			</VBox>

			<VBox spacing="3">
				<HBox spacing="10" alignment="CENTER_LEFT">
					<Label text="Member ID:" minWidth="80"
						style="-fx-text-fill: #333333; -fx-font-size: 16px;" />
					<ComboBox fx:id="memberIdComboBox"
						promptText="Select Member ID" prefWidth="220" />
				</HBox>
				<Label fx:id="memberIdError" style="-fx-font-size: 10;"
					textFill="red">
					<padding>
						<Insets top="0" right="0" bottom="0" left="90" />
					</padding>
				</Label>
			</VBox>

			<VBox spacing="3">
				<HBox spacing="10" alignment="CENTER_LEFT">
					<Label text="Issue Date:" minWidth="80"
						style="-fx-text-fill: #333333; -fx-font-size: 16px;" />
					<DatePicker fx:id="issueDatePicker" prefWidth="220" />
				</HBox>
				<Label fx:id="issueDateError" style="-fx-font-size: 10;"
					textFill="red">
					<padding>
						<Insets top="0" right="0" bottom="0" left="90" />
					</padding>
				</Label>
			</VBox>

			<HBox spacing="50" alignment="CENTER">
				<Button fx:id="issueBookButton" text="Issue Book"
					onAction="#handleIssueBook" styleClass="book-button"
					prefWidth="120" />
				<Button text="Back" onAction="#Back"
					styleClass="book-buttons" prefWidth="100" />
			</HBox>
		</VBox>
	</children>
</AnchorPane>
