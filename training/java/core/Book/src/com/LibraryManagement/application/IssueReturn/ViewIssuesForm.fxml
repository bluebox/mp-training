<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<AnchorPane xmlns="http://javafx.com/javafx/24.0.1"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.LibraryManagement.controller.ViewAllIssuesController"
	prefWidth="800.0" prefHeight="550.0"
	stylesheets="@../../application/css/viewbook.css">

	<VBox alignment="CENTER" spacing="20.0" layoutX="25.0"
		layoutY="40.0" prefWidth="750.0" prefHeight="450.0"
		style="-fx-padding: 20;">
		<children>
			<TableView fx:id="issueTable" prefWidth="750.0"
				prefHeight="350.0">
				<columns>
					<TableColumn fx:id="issueIdCol" text="Issue ID"
						prefWidth="100.0" />
					<TableColumn fx:id="bookIdCol" text="Book ID"
						prefWidth="100.0" />
					<TableColumn fx:id="memberIdCol" text="Member ID"
						prefWidth="120.0" />
					<TableColumn fx:id="availabilityCol"
						text="Availability" prefWidth="80.0" />
					<TableColumn fx:id="issueDateCol" text="Issue Date"
						prefWidth="120.0" />
					<TableColumn fx:id="returnDateCol" text="Return Date"
						prefWidth="120.0" />
				</columns>
			</TableView>

			<Button text="Back" onAction="#Back" styleClass="book-buttons"
				textFill="RED" />
		</children>
	</VBox>
</AnchorPane>