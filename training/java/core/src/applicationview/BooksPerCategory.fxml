<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400" prefWidth="600" spacing="10" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.BooksPerCategoryController">

    <TableView fx:id="categoryTable" prefHeight="300" style="-fx-background-color: #EAC8A6;">
        <columns>
            <TableColumn fx:id="categoryColumn" prefWidth="200" text="Category" />
            <TableColumn fx:id="countColumn" prefWidth="100" text="Count" />
        </columns>
    </TableView>
   <Button mnemonicParsing="false" onAction="#gotoHome" style="-fx-background-color: #B1AB86;" text="Home">
      <font>
         <Font name="Bookman Old Style Bold" size="12.0" />
      </font>
   </Button>

</VBox>
