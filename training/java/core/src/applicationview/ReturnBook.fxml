<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="200" prefWidth="400" style="-fx-background-color: #81E7AF;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ReturnBookController">
    <children>
        <VBox layoutX="50" layoutY="30" spacing="10" />
      <Button layoutY="2.0" mnemonicParsing="false" onAction="#gotoHome" style="-fx-background-color: #F1BA88;" text="Home" />
      <Label layoutX="64.0" layoutY="22.0" text="Library Management System - Return Book ">
         <font>
            <Font name="Bookman Old Style Bold" size="14.0" />
         </font>
      </Label>
         <Button layoutX="168.0" layoutY="144.0" onAction="#handleReturnBook" style="-fx-background-color: #F1BA88;" text="Return Book" />
         <TextField fx:id="bookIdField" layoutX="168.0" layoutY="100.0" promptText="Book ID" />
         <TextField fx:id="memberIdField" layoutX="168.0" layoutY="56.0" promptText="Member ID" />
      <Label layoutX="81.0" layoutY="60.0" text="MemberId:" />
      <Label layoutX="81.0" layoutY="104.0" text="BookId:" />
    </children>
</AnchorPane>
