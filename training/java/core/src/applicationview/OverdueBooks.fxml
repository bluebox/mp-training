<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400" prefWidth="600" spacing="10" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.OverdueBooksController">

    <TableView fx:id="overdueBooksTable" prefHeight="300" style="-fx-background-color: #FFEDFA;">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="80" text="Book ID" />
            <TableColumn fx:id="titleColumn" prefWidth="150" text="Title" />
            <TableColumn fx:id="authorColumn" prefWidth="150" text="Author" />
            <TableColumn fx:id="categoryColumn" prefWidth="120" text="Category" />
        </columns>
    </TableView>
   <Button mnemonicParsing="false" onAction="#gotoHome" style="-fx-background-color: #CCDF92;" text="Home">
      <font>
         <Font name="Bookman Old Style Bold" size="13.0" />
      </font>
   </Button>

</VBox>
