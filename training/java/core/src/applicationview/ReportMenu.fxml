<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ReportMenuController"
      alignment="CENTER" spacing="20.0"
      prefWidth="400.0" prefHeight="300.0">

    <Button text="Overdue Books" onAction="#handleOverdueBooks" prefWidth="200.0"/>
    <Button text="Books per Category" onAction="#handleBooksPerCategory" prefWidth="200.0"/>
    <Button text="Members with Issued Books" onAction="#handleActiveIssuedBooks" prefWidth="200.0"/>

</VBox>

