<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
 <?import javafx.geometry.Insets?>

<AnchorPane prefWidth="800.0" prefHeight="550.0"
	xmlns="http://javafx.com/javafx/24.0.1"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.LibraryManagement.controller.AddMemberController"
	stylesheets="@../../application/css/addMember.css"
	styleClass="member-form">

	<children>
		<VBox spacing="15" alignment="CENTER" prefWidth="400"
			layoutX="200" layoutY="50">
			<Label text="Register Member" styleClass="form-title">
				<font>
					<Font name="Arial Bold" size="22.0" />
				</font>
			</Label>

			<VBox spacing="3">
				<HBox spacing="10" alignment="CENTER_LEFT">
					<Label text="Name:" minWidth="80"
						style="-fx-text-fill: #333333; -fx-font-size: 16px;" />
					<TextField fx:id="nameField" promptText="Enter full name"
						prefWidth="220" />
				</HBox>
				<Label fx:id="nameErrorLabel" style="-fx-font-size: 10;"
					textFill="red">
					<padding>
						<Insets top="0" right="0" bottom="0" left="90" />
					</padding>
				</Label>
			</VBox>

			<VBox spacing="3">
				<HBox spacing="10" alignment="CENTER_LEFT">
					<Label text="Email:" minWidth="80"
						style="-fx-text-fill: #333333; -fx-font-size: 16px;" />
					<TextField fx:id="emailField" promptText="Enter email"
						prefWidth="220" />
				</HBox>
				<Label fx:id="emailErrorLabel" style="-fx-font-size: 10;"
					textFill="red">
					<padding>
						<Insets top="0" right="0" bottom="0" left="90" />
					</padding>
				</Label>
			</VBox>

			<VBox spacing="3">
				<HBox spacing="10" alignment="CENTER_LEFT">
					<Label text="Mobile:" minWidth="80"
						style="-fx-text-fill: #333333; -fx-font-size: 16px;" />
					<TextField fx:id="mobileField"
						promptText="Enter mobile number" prefWidth="220" />
				</HBox>
				<Label fx:id="mobileErrorLabel" style="-fx-font-size: 10;"
					textFill="red">
					<padding>
						<Insets top="0" right="0" bottom="0" left="90" />
					</padding>
				</Label>
			</VBox>

			<VBox spacing="3">
				<HBox spacing="10" alignment="CENTER_LEFT">
					<Label text="Gender:" minWidth="80"
						style="-fx-text-fill: #333333; -fx-font-size: 16px;" />
					<ComboBox fx:id="genderCombo" promptText="Select gender"
						prefWidth="220">
						<items>
							<FXCollections fx:factory="observableArrayList">
								<String fx:value="Male" />
								<String fx:value="Female" />
							</FXCollections>
						</items>
					</ComboBox>
				</HBox>
				<Label fx:id="genderErrorLabel" style="-fx-font-size: 10;"
					textFill="red">
					<padding>
						<Insets top="0" right="0" bottom="0" left="90" />
					</padding>
				</Label>
			</VBox>

			<VBox spacing="3">
				<HBox spacing="10" alignment="CENTER_LEFT">
					<Label text="Address:" minWidth="80"
						style="-fx-text-fill: #333333; -fx-font-size: 16px;" />
					<TextArea fx:id="addressArea" promptText="Enter address"
						prefWidth="220" prefHeight="60" wrapText="true" />
				</HBox>
				<Label fx:id="addressErrorLabel" style="-fx-font-size: 10;"
					textFill="red">
					<padding>
						<Insets top="0" right="0" bottom="0" left="90" />
					</padding>
				</Label>
			</VBox>

			<HBox spacing="20" alignment="CENTER">
				<Button fx:id="addMemberButton" text="Register"
					onAction="#handleRegister" styleClass="book-button" prefWidth="120" />
				<Button text="Back" onAction="#Back"
					styleClass="book-buttons" prefWidth="100" />
			</HBox>
		</VBox>
	</children>
</AnchorPane>
