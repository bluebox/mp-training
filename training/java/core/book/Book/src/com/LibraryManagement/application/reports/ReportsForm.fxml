<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane xmlns="http://javafx.com/javafx/24.0.1"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.LibraryManagement.controller.ReportsController"
	prefWidth="800.0" prefHeight="600.0"
	stylesheets="@../../application/css/reports.css">

	<children>
		<Label layoutX="350.0" layoutY="20.0" text="Reports"
			style="-fx-font-size: 18px; -fx-font-weight: bold;" />

		<VBox layoutX="50.0" layoutY="70.0" spacing="20.0">
			<children>
				<Button styleClass="book-button" mnemonicParsing="false"
					onAction="#OverDue" text="Overdue Books" />
				<Button styleClass="book-button" mnemonicParsing="false"
					onAction="#BooksPerCategory" text="Count of Books per Category" />
				<Button styleClass="book-button" mnemonicParsing="false"
					onAction="#ActiveIssuedMembers" text="Active Issued Members" />
				<Button text="Back" onAction="#Back"
					styleClass="book-buttons" textFill="RED" prefWidth="160.0" />
			</children>
		</VBox>

		<StackPane fx:id="tableContainer" layoutX="250.0"
			layoutY="70.0" prefWidth="500.0" prefHeight="300.0">
			<children>
				<TableView fx:id="overdueBooksTable" visible="false">
					<columns>
						<TableColumn fx:id="overdueTitleCol" text="Title"
							prefWidth="200.0" />
						<TableColumn fx:id="overdueMemberCol" text="Member"
							prefWidth="150.0" />
						<TableColumn fx:id="overdueDateCol" text="Due Date"
							prefWidth="150.0" />
					</columns>
				</TableView>

				<TableView fx:id="categoryCountTable" visible="false">
					<columns>
						<TableColumn fx:id="categoryNameCol" text="Category"
							prefWidth="250.0" />
						<TableColumn fx:id="categoryCountCol" text="Count"
							prefWidth="250.0" />
					</columns>
				</TableView>
				<TableView fx:id="activeMembersTable" visible="false">
					<columns>
						<TableColumn fx:id="memberNameCol" text="Member Name"
							prefWidth="250.0" />
						<TableColumn fx:id="booksIssuedCol"
							text="Books Issued" prefWidth="250.0" />
					</columns>
				</TableView>
			</children>
		</StackPane>
	</children>
</AnchorPane>