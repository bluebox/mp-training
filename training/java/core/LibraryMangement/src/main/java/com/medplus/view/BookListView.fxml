<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.medplus.controller.BookListViewController">
    <Label text="Book List"/>
    <TableView fx:id="bookTable">
        <columns>
            <TableColumn fx:id="titleCol" text="Title"/>
            <TableColumn fx:id="authorCol" text="Author"/>
            <TableColumn fx:id="categoryCol" text="Category"/>
        </columns>
    </TableView>
</VBox>
