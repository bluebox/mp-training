<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>

<GridPane alignment="center" xmlns="http://javafx.com/javafx/8.0.171"
					 xmlns:fx="http://javafx.com/fxml/1" 
					 fx:controller="July21.javafxControllerIntro.SecondaryController"
					 hgap="10" vgap="10">
					 
		 <TextField GridPane.rowIndex="0" GridPane.columnIndex="0" fx:id="nameField"
		 onKeyReleased="#handleKeyReleased" />
		 <Button text="button 1" GridPane.rowIndex="0" GridPane.columnIndex="1"
		 	 onAction="#onButtonClick" fx:id="button1" /> 
		 <Button text="button 2" GridPane.rowIndex="0" GridPane.columnIndex="2"
		 	 onAction="#onButtonClick" fx:id="button2" /> 
		 	 
		 <CheckBox fx:id="checkBox" text="clear" 
		 		GridPane.rowIndex="1" GridPane.columnIndex="0"
		 		onAction="#handleChange" />
		 
		 <Label fx:id="label" text = "label" 
		 	GridPane.rowIndex="1" GridPane.columnIndex="1" />
					 
</GridPane>
