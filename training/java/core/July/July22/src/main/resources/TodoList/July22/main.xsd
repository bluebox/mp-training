<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://javafx.com/javafx/8.0.171">
	<xs:element name="BorderPane">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="left">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="ListView" type="xs:string" />
							<xs:element name="center">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="TextArea" type="xs:string" />
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>