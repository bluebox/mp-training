<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="750.0" prefWidth="664.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lms.controller.ViewBooksController">
   <children>
      <TableView fx:id="bookTable" layoutY="64.0" prefHeight="750.0" prefWidth="664.0" style="-fx-background-color: #83C5BE;">
         <columns>
            <TableColumn fx:id="bookIdColumn" prefWidth="75.0" text="Book Id" />
            <TableColumn fx:id="titleColumn" prefWidth="202.0" text="Title" />
            <TableColumn fx:id="authorColumn" prefWidth="104.0" text="Author" />
            <TableColumn fx:id="categoryColumn" prefWidth="119.0" text="Category" />
            <TableColumn fx:id="statusColumn" prefWidth="71.0" text="Status" />
            <TableColumn fx:id="availabilityColumn" prefWidth="92.0" text="Availability" />
         </columns>
      </TableView>
      <Label layoutX="205.0" layoutY="7.0" text="View All Books">
         <font>
            <Font name="System Bold" size="35.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
