<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="520.0" prefWidth="880.0"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/8.0.171"
            fx:controller="Controller.ReportsController">

    <children>
        <!-- Full Background Image -->
        <ImageView fitWidth="1200.0" fitHeight="700.0" preserveRatio="false" pickOnBounds="true">
      <image>
         <Image url="@download.jpg" />
      </image>
   </ImageView>

        <!-- VBox with Buttons (No Background Pane) -->
        <VBox layoutX="460.0" layoutY="220.0" alignment="CENTER" spacing="20.0"
              prefWidth="360.0" prefHeight="320.0">
            <children>
                <Button text="Overdue Books" onAction="#handleOverdueBooks" prefWidth="280.0" prefHeight="50.0"
                        style="-fx-background-color: #2979FF; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 10;" />
                
                <Button text="Books per Category" onAction="#handleBooksPerCategory" prefWidth="280.0" prefHeight="50.0"
                        style="-fx-background-color: #00C853; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 10;" />
                
                <Button text="Members with Issued Books" onAction="#handleActiveIssuedBooks" prefWidth="280.0" prefHeight="50.0"
                        style="-fx-background-color: #FF6D00; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 10;" />
                
                <Button text="Back" onAction="#handleBackToHome" prefWidth="280.0" prefHeight="45.0"
                        style="-fx-background-color: #757575; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 10;" />
            </children>
        </VBox>
    </children>
</AnchorPane>
