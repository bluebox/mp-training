<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.BookController"
            prefHeight="500.0" prefWidth="600.0"
            style="-fx-background-color: linear-gradient(to bottom right, #f0f8ff, #cce7ff);">
   
   <children>
     <Button layoutX="20.0" layoutY="20.0" text="Back"
                onAction="#goToPreviousScene"
                style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-background-radius: 8;">
            <font><Font name="Segoe UI Bold" size="12.0" /></font>
        </Button>

      <Label layoutX="100.0" layoutY="30.0" text="Library Management System - Add Book" textFill="#333">
         <font>
            <Font name="Segoe UI Bold" size="20.0" />
         </font>
      </Label>

      <Label layoutX="130.0" layoutY="90.0" text="Book Title:" textFill="#2e4053">
         <font>
            <Font name="Segoe UI Semibold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="titlefield" layoutX="230.0" layoutY="85.0" prefWidth="220.0"/>

      <Label layoutX="130.0" layoutY="140.0" text="Author:" textFill="#2e4053">
         <font>
            <Font name="Segoe UI Semibold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="Authorfield" layoutX="230.0" layoutY="135.0" prefWidth="220.0"/>

      <Label layoutX="130.0" layoutY="190.0" text="Category:" textFill="#2e4053">
         <font>
            <Font name="Segoe UI Semibold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="categoryfield" layoutX="230.0" layoutY="185.0" prefWidth="220.0"/>

      <Label layoutX="130.0" layoutY="240.0" text="Status:" textFill="#2e4053">
         <font>
            <Font name="Segoe UI Semibold" size="14.0" />
         </font>
      </Label>
      <RadioButton fx:id="Active" layoutX="230.0" layoutY="235.0" text="Active" onAction="#handleStatusSelection"/>
      <RadioButton fx:id="Inactive" layoutX="310.0" layoutY="235.0" text="Inactive" onAction="#handleStatusSelection"/>

      <Label layoutX="130.0" layoutY="290.0" text="Availability:" textFill="#2e4053">
         <font>
            <Font name="Segoe UI Semibold" size="14.0" />
         </font>
      </Label>
      <RadioButton fx:id="Available" layoutX="230.0" layoutY="285.0" text="Available" onAction="#handleAvailabilitySelection"/>
      <RadioButton fx:id="Issued" layoutX="310.0" layoutY="285.0" text="Issued" onAction="#handleAvailabilitySelection"/>

      <Button layoutX="245.0" layoutY="360.0" text="Submit"
              onAction="#addBook"
              style="-fx-background-color: #1976d2; -fx-text-fill: white; -fx-background-radius: 8;">
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Button>

   </children>
</AnchorPane>
