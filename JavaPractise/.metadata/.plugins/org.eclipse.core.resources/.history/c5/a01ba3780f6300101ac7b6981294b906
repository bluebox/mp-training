import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;

public class SimpleHttpGet {

    public static void main(String[] args) {
        // 1. Create an HttpClient instance
        HttpClient client = HttpClient.newHttpClient();

        // 2. Build an HttpRequest for a GET request
        HttpRequest request = HttpRequest.newBuilder()
                .uri(URI.create("https://jsonplaceholder.typicode.com/posts/1")) // Target URL
                .GET() // Specify GET method (default if not specified)
                .build();

        try {
            // 3. Send the request and get the response synchronously
            HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());

            // 4. Process the response
            System.out.println("Response Status Code: " + response.statusCode());
            System.out.println("Response Body:\n" + response.body());

        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}