package repository;

import model.Member;
import util.DBUtil;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;

public class MemberRepository {

    public void addMember(Member member) {
        String sql = "INSERT INTO members VALUES (?, ?, ?, ?)";
        try (Connection conn = DBUtil.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setString(1, member.getId());
            ps.setString(2, member.getName());
            ps.setInt(3, member.getAge());
            ps.setInt(4, member.getPlanId());
            ps.executeUpdate();
            System.out.println("Member added.");
        } catch (Exception e) {
            System.out.println("Error adding member: " + e.getMessage());
        }
    }

    public List<Member> getAllMembers() {
        List<Member> list = new ArrayList<>();
        String sql = "SELECT * FROM members";
        try (Connection conn = DBUtil.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {
            while (rs.next()) {
                list.add(new Member(rs.getString(1), rs.getString(2), rs.getInt(3), rs.getInt(4)));
            }
        } catch (Exception e) {
            System.out.println("Error fetching members: " + e.getMessage());
        }
        return list;
    }

    public void updateMemberDetails(String id, String name, int age) {
        String sql = "UPDATE members SET name=?, age=? WHERE member_id=?";
        try (Connection conn = DBUtil.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setString(1, name);
            ps.setInt(2, age);
            ps.setString(3, id);
            ps.executeUpdate();
            System.out.println("Member updated.");
        } catch (Exception e) {
            System.out.println("Error updating member: " + e.getMessage());
        }
    }

    public void updateMemberPlan(String id, int planId) {
        String sql = "UPDATE members SET plan_id=? WHERE member_id=?";
        try (Connection conn = DBUtil.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setInt(1, planId);
            ps.setString(2, id);
            ps.executeUpdate();
            System.out.println("Plan updated.");
        } catch (Exception e) {
            System.out.println("Error updating plan: " + e.getMessage());
        }
    }

    public void deleteMember(String id) {
        String sql = "DELETE FROM members WHERE member_id=?";
        try (Connection conn = DBUtil.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setString(1, id);
            ps.executeUpdate();
            System.out.println("Member deleted.");
        } catch (Exception e) {
            System.out.println("Error deleting member: " + e.getMessage());
        }
    }

    public Member getMemberById(String id) {
        String sql = "SELECT * FROM members WHERE member_id=?";
        try (Connection conn = DBUtil.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setString(1, id);
            ResultSet rs = ps.executeQuery();
            if (rs.next()) return new Member(rs.getString(1), rs.getString(2), rs.getInt(3), rs.getInt(4));
        } catch (Exception e) {
            System.out.println("Error fetching member: " + e.getMessage());
        }
        return null;
    }
}
